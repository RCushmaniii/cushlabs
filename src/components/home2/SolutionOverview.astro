---
import Container from '../layout/Container.astro';
import terms from '../../data/commercialTerms.json';

interface Props {
  locale: 'en' | 'es';
}

const { locale } = Astro.props;

// Prices are IMPORTED, never typed. commercialTerms.json is synced from
// operating-system/cushlabs/commercial-terms.json (`npm run sync:terms`), the same file
// /pricing/ is validated against. Typing "$129" here would be a second price list.

// This section used to list six separate products under "What I build", directly under
// a sentence saying "one assistant, not five disconnected tools" — the layout argued
// against the copy. Replaced 2026-10-01 with the three plans, which is how it is
// actually sold. Bullets are a SUMMARY of the tier features on /pricing/
// (src/components/pricing/PricingSection.astro); if a tier's contents change there,
// change them here in the same PR.
type TierId = 'basic' | 'premium' | 'ultra';

interface Tier {
  id: TierId;
  name: string;
  tagline: string;
  bullets: string[];
}

interface LocaleContent {
  heading: string;
  body: string;
  label: string;
  recommended: string;
  perMonth: string;
  mexicoPrefix: string;
  detailsLabel: string;
  pricingPath: string;
  tiers: Tier[];
  footnote: string;
  cta: string;
  ctaLink: string;
}

const content: Record<'en' | 'es', LocaleContent> = {
  en: {
    heading: 'One Assistant. More Channels as You Grow.',
    body: "It's one assistant, not five disconnected tools. I build it around your services, prices, policies, and the way you talk to customers. Pick the plan that covers the channels your customers use today, and move up when you're ready. Update it once, and every channel changes.",
    label: 'Three plans, one assistant',
    recommended: 'Recommended',
    perMonth: 'USD/mo',
    mexicoPrefix: 'Mexico:',
    detailsLabel: "See what's included",
    pricingPath: '/pricing/',
    tiers: [
      {
        id: 'basic',
        name: 'Basic',
        tagline: 'Your Facebook Page, covered',
        bullets: [
          'AI assistant on Facebook Messenger, 24/7',
          'Google review replies — you approve, it posts',
          'Leads captured, with a WhatsApp alert to you',
        ],
      },
      {
        id: 'premium',
        name: 'Premium',
        tagline: 'Everywhere your customers write',
        bullets: [
          'Everything in Basic, plus Instagram and your website',
          'WhatsApp reminders from your own number',
          'Weekly local SEO & competitor report',
        ],
      },
      {
        id: 'ultra',
        name: 'Ultra',
        tagline: 'Your phone answered too',
        bullets: [
          'Everything in Premium, plus the AI Voice Agent',
          '300 answered minutes per location, every month',
          'Priority support, tuned to your industry',
        ],
      },
    ],
    footnote: 'Every plan: fully managed, up to 2 locations, free 1-week trial, no contract.',
    cta: 'See My Services →',
    ctaLink: '/services/',
  },
  es: {
    heading: 'Un Solo Asistente. Más Canales Conforme Creces.',
    body: 'Es un solo asistente, no cinco herramientas sueltas. Lo construyo con tus servicios, tus precios, tus políticas y la forma en que le hablas a tus clientes. Elige el plan que cubre los canales que hoy usan tus clientes, y sube de plan cuando quieras. Lo actualizas una vez y cambia en todos los canales.',
    label: 'Tres planes, un solo asistente',
    recommended: 'Recomendado',
    perMonth: 'MXN/mes + IVA',
    mexicoPrefix: '',
    detailsLabel: 'Ver qué incluye',
    pricingPath: '/es/precios/',
    tiers: [
      {
        id: 'basic',
        name: 'Básico',
        tagline: 'Tu página de Facebook, cubierta',
        bullets: [
          'Asistente con IA en Facebook Messenger, 24/7',
          'Respuestas a reseñas de Google — tú apruebas, se publica sola',
          'Prospectos capturados, con alerta por WhatsApp',
        ],
      },
      {
        id: 'premium',
        name: 'Premium',
        tagline: 'Donde sea que te escriban',
        bullets: [
          'Todo lo de Básico, más Instagram y tu sitio web',
          'Recordatorios por WhatsApp desde tu propio número',
          'Reporte semanal de SEO local y competencia',
        ],
      },
      {
        id: 'ultra',
        name: 'Ultra',
        tagline: 'También contesta tu teléfono',
        bullets: [
          'Todo lo de Premium, más el Agente de Voz con IA',
          '300 minutos contestados por sucursal, cada mes',
          'Soporte prioritario, ajustado a tu industria',
        ],
      },
    ],
    footnote: 'Todos los planes: totalmente gestionado, hasta 2 sucursales, prueba gratis de 1 semana, sin contrato.',
    cta: 'Ver Mis Servicios →',
    ctaLink: '/es/services/',
  },
};

const t = content[locale];
---

{/* Top padding is deliberately small — see the note on SocialProof above, which is
    the section immediately before this one. Together they used to stack 256px. */}
<section aria-labelledby="solutions-heading" class="pt-10 pb-14 md:pt-12 md:pb-16 relative">
  <Container size="lg">
    {/* items-START, not items-center. Centring a short column against a tall one
        drops the headline below the fold of the section and the reader enters at the
        upper right, which is the wrong end of the argument. */}
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-start">
      <!-- Left text -->
      <div>
        {/* text-balance, NOT a forced two-line break. Two lines would need the second
            line ("Your Business Needs It Most." — 28 characters) to fit the column,
            which at 544px means roughly a 35px type size: a 27% cut to the headline to
            win a line break. Balancing instead fixes the actual ugliness, which was
            "Most." sitting alone on line three. */}
        <h2 id="solutions-heading" class="font-display text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 dark:text-white mb-6 leading-tight text-balance">
          {t.heading}
        </h2>
        <p class="text-xl text-gray-600 dark:text-gray-300 mb-8 leading-relaxed">
          {t.body}
        </p>

        <div class="flex flex-wrap gap-4">
          <a href={locale === 'es' ? '/es/reservar/' : '/consultation/'} class="inline-flex items-center gap-2 px-6 py-3 bg-cush-orange text-black font-display font-semibold rounded-lg hover:bg-cush-orange/90 transition-all duration-300 shadow-lg shadow-cush-orange/25 hover:shadow-xl hover:shadow-cush-orange/30 group">
            {locale === 'es' ? 'Agenda una Llamada Gratis de 30 Min' : 'Book a Free 30-Min Call'}
            <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a href={t.ctaLink} class="inline-flex items-center gap-2 px-6 py-3 border-2 border-gray-300 dark:border-gray-700 text-gray-700 dark:text-gray-300 font-display font-semibold rounded-lg hover:border-cush-orange hover:text-accent-text transition-all duration-300">
            {t.cta}
          </a>
        </div>
      </div>

      <!-- Right: the three plans -->
      <div>
        <p class="text-sm font-display font-semibold uppercase tracking-wider text-accent-text mb-6">
          {t.label}
        </p>

        <div class="space-y-4">
          {t.tiers.map((tier) => {
            const featured = tier.id === 'premium';
            const price = locale === 'es' ? terms.pricing.mxn.display[tier.id] : terms.pricing.usd.display[tier.id];
            return (
              <a
                href={`${t.pricingPath}#${tier.id}`}
                class:list={[
                  'block rounded-2xl border p-5 md:p-6 transition-colors duration-300 group',
                  featured
                    ? 'border-cush-orange/60 bg-cush-orange/5 hover:border-cush-orange'
                    : 'border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 hover:border-cush-orange/50',
                ]}
              >
                <h3 class="font-display font-bold text-xl text-gray-900 dark:text-white">
                  {tier.name}
                  {featured && (
                    <span class="ml-2 align-middle inline-flex px-2 py-0.5 rounded-full bg-cush-orange text-black text-xs font-semibold">
                      {t.recommended}
                    </span>
                  )}
                </h3>
                <p class="text-sm text-gray-600 dark:text-gray-400 mb-3">{tier.tagline}</p>
                <ul class="space-y-1.5 mb-4">
                  {tier.bullets.map((b) => (
                    <li class="flex items-start gap-2 text-gray-700 dark:text-gray-300">
                      <svg class="w-4 h-4 text-accent-text mt-1 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                      </svg>
                      <span>{b}</span>
                    </li>
                  ))}
                </ul>
                {/* Price sits BELOW its own bullets on purpose. With it at the top, the
                    page text read "...Premium bullets  Ultra $349", and both
                    validate-feature-tiers and a skimming reader paired Premium's
                    features with Ultra's price. */}
                <div class="flex flex-wrap items-end justify-between gap-x-4 gap-y-2 pt-3 border-t border-gray-100 dark:border-gray-800">
                  <p class="font-display text-gray-900 dark:text-white leading-tight">
                    <span class="text-2xl font-bold">{price}</span>
                    <span class="text-sm text-gray-500 dark:text-gray-400"> {t.perMonth}</span>
                    {locale === 'en' && (
                      <span class="block text-xs font-sans text-gray-500 dark:text-gray-400 mt-0.5">
                        {t.mexicoPrefix} {terms.pricing.mxn.display[tier.id]} MXN + IVA
                      </span>
                    )}
                  </p>
                  <span class="inline-flex items-center gap-1.5 font-display text-sm font-semibold text-accent-text">
                    {t.detailsLabel}
                    <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                    </svg>
                  </span>
                </div>
              </a>
            );
          })}
        </div>

        <p class="mt-4 text-sm text-gray-600 dark:text-gray-400">{t.footnote}</p>
      </div>
    </div>
  </Container>
</section>
