        icon: "M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.29.173-1.414-.074-.124-.272-.198-.57-.347z",
        href: "/es/whatsapp/",
        linkLabel: "Ver cómo funciona",
      },
      {
        title: "Inteligencia de Negocio y Automatización",
        desc: "Monitorea competidores, automatiza tareas repetitivas y convierte tus datos en acciones claras — un correo a la semana, no otro tablero.",
        icon: "M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z",
        href: "/es/competitive-intelligence/",
        linkLabel: "Ver cómo funciona"
      }
    ],
    differentiator: "Cada sistema se entrena con TU negocio — no con una plantilla genérica.",
    cta: 'Ver Mis Servicios →',
    ctaLink: '/es/services/'
  }
};

const t = content[locale];
---

{/* Top padding is deliberately small — see the note on SocialProof above, which is
    the section immediately before this one. Together they used to stack 256px. */}
<section aria-labelledby="solutions-heading" class="pt-10 pb-14 md:pt-12 md:pb-16 relative">
  <Container size="lg">
    {/* items-START, not items-center. Centring a short column against a tall one
        drops the headline below the fold of the section and the reader enters at the
        upper right, which is the wrong end of the argument. */}
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-start">
      <!-- Left text -->
      <div>
        {/* text-balance, NOT a forced two-line break. Two lines would need the second
            line ("Your Business Needs It Most." — 28 characters) to fit the column,
            which at 544px means roughly a 35px type size: a 27% cut to the headline to
            win a line break. Balancing instead fixes the actual ugliness, which was
            "Most." sitting alone on line three. */}
        <h2 id="solutions-heading" class="font-display text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 dark:text-white mb-6 leading-tight text-balance">
          {t.heading}
        </h2>
        <p class="text-xl text-gray-600 dark:text-gray-300 mb-8 leading-relaxed">
          {t.body}
        </p>

        <div class="flex flex-wrap gap-4">
          <a href={locale === 'es' ? '/es/reservar/' : '/consultation/'} class="inline-flex items-center gap-2 px-6 py-3 bg-cush-orange text-black font-display font-semibold rounded-lg hover:bg-cush-orange/90 transition-all duration-300 shadow-lg shadow-cush-orange/25 hover:shadow-xl hover:shadow-cush-orange/30 group">
            {locale === 'es' ? 'Agenda una Llamada Gratis de 30 Min' : 'Book a Free 30-Min Call'}
            <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a href={t.ctaLink} class="inline-flex items-center gap-2 px-6 py-3 border-2 border-gray-300 dark:border-gray-700 text-gray-700 dark:text-gray-300 font-display font-semibold rounded-lg hover:border-cush-orange hover:text-accent-text transition-all duration-300">
            {t.cta}
          </a>
        </div>
      </div>

      <!-- Right list -->
      <div class="divide-y divide-black/[0.07] dark:divide-white/10">
        {/* Was "That looks like:", then "What that looks like in practice". Both lean
            on an antecedent, and in a two-column layout the thing they point back to
            is beside them rather than above them, so the reference never lands. "What
            I build" names it directly and keeps the first person the rest of the page
            uses. Do not revert to a "that"-form here. */}
        <p class="text-sm font-display font-semibold uppercase tracking-wider text-accent-text mb-6">
          {locale === 'en' ? 'What I build' : 'Lo que construyo'}
        </p>
        
        {t.pillars.map((pillar, _i) => (
          <div class:list={["flex gap-5 group py-6", _i === 0 && "pt-0"]}>
            <div class="shrink-0 w-12 h-12 rounded-full bg-cush-orange/10 flex items-center justify-center group-hover:bg-cush-orange group-hover:text-black dark:text-white text-gray-900 transition-colors duration-300">
              <svg class="w-6 h-6 text-accent-text group-hover:text-black transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={pillar.icon} />
              </svg>
            </div>
            <div>
              <p class="text-lg md:text-xl text-gray-700 dark:text-gray-300 leading-relaxed">
                <strong class="font-semibold text-gray-900 dark:text-white block sm:inline">
                  {pillar.title}
                  {/* Two visually distinct states. A "Coming soon" badge wearing the
                      green live-dot styling reads as shipped at a glance, which is the
                      opposite of what it is for — the pulsing dot in particular says
                      "running right now". Coming items get a muted, dot-free treatment
                      and a dashed border, matching how /pricing/ renders its `soon:`
                      entries so the two surfaces agree. */}
                  {pillar.badge && (
                    pillar.comingSoon ? (
                      <span class="inline-flex items-center ml-2 px-2 py-0.5 rounded-full border border-dashed border-muted/50 text-muted text-xs font-semibold align-middle whitespace-nowrap">
                        {pillar.badge}
                      </span>
                    ) : (
                      <span class="inline-flex items-center gap-1.5 ml-2 px-2 py-0.5 rounded-full bg-green-500/10 border border-green-500/20 text-green-600 dark:text-green-400 text-xs font-semibold align-middle whitespace-nowrap">
                        <span class="w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse"></span>
                        {pillar.badge}
                      </span>
                    )
                  )}
                </strong> {pillar.desc}
              </p>
              {pillar.href && (
                <a
                  href={pillar.href}
                  class="inline-flex items-center gap-1.5 mt-2 font-display text-sm font-semibold text-accent-text hover:text-accent-text/80 transition-colors group/link"
                >
                  {pillar.linkLabel}
                  <svg class="w-4 h-4 transition-transform group-hover/link:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                  </svg>
                </a>
              )}
            </div>
          </div>
        ))}

        {/* ml-[68px] at sm+ lines this up with the service text, not the icon rail:
            w-12 icon (48px) + gap-5 (20px). Left flush on mobile, where a 68px indent
            would eat the column. */}
        <div class="mt-6 sm:ml-[68px] p-5 bg-gray-50 dark:bg-gray-800/50 rounded-xl border border-gray-200 dark:border-gray-800 text-sm text-gray-600 dark:text-gray-400">
          <svg class="w-5 h-5 text-green-500 inline-block mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          {locale === 'en' 
            ? 'Every system includes validated answers, analytics, and clean documentation.'
            : 'Cada sistema incluye respuestas validadas, analíticas y documentación clara.'}
        </div>
      </div>
    </div>
  </Container>
</section>
