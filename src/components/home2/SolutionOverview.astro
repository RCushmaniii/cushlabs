---
import Container from '../layout/Container.astro';

interface Props {
  locale: 'en' | 'es';
}

const { locale } = Astro.props;

interface Pillar {
  title: string;
  desc: string;
  icon: string;
  href?: string;
  linkLabel?: string;
  badge?: string;
  /** Renders the badge in the muted not-yet-shipped style instead of the green live style. */
  comingSoon?: boolean;
}

interface LocaleContent {
  heading: string;
  body: string;
  pillars: Pillar[];
  differentiator: string;
  cta: string;
  ctaLink: string;
}

const content: Record<'en' | 'es', LocaleContent> = {
  en: {
    heading: 'Put AI to Work Where Your Business Needs It Most.',
    body: "Start with one problem. Add more as your business grows. I build practical AI systems around the work that's taking your time or costing you customers.",
    pillars: [
      {
        title: "AI Messaging Assistant",
        desc: "Answers questions and captures leads on Messenger and your website — even when you can't. English and Spanish, 24/7.",
        icon: "M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z",
        href: "/messenger-assistant/",
        linkLabel: "See the live demo",
        badge: "Live now"
      },
      {
        title: "AI Voice Agent",
        desc: "Answers calls, qualifies leads, and books appointments — no one waits on hold. Natural voice, bilingual, 24/7.",
        icon: "M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z",
        href: "/voice-agent/",
        linkLabel: "See how it works"
      },
      {
        title: "WhatsApp Follow-Up & Reminders",
        desc: "Confirms appointments, sends reminders, and follows up — on the channel your customers actually open. Fewer no-shows.",
        icon: "M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.29.173-1.414-.074-.124-.272-.198-.57-.347z",
        href: "/whatsapp/",
        linkLabel: "See how it works",
        // LIVE since 2026-09-19. The old note here said the Meta app was "approved
        // but not yet flipped to Live" — it has been Live since July, App Review is
        // approved for both WhatsApp permissions, and the platform messages real
        // recipients daily. Onboarding is a guided call by design, not because
        // anything is unfinished; that is a sales model, not a coming feature.
      },
      {
        title: "Business Intelligence & Automation",
        desc: "Monitors competitors, automates repetitive work, and turns your data into clear actions — one email a week, not another dashboard.",
        icon: "M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z",
        href: "/competitive-intelligence/",
        linkLabel: "See how it works"
      }
    ],
    differentiator: "Every system is built around YOUR business — not a generic template.",
    cta: 'See My Services →',
    ctaLink: '/services/'
  },
  es: {
    heading: 'Pon la IA a Trabajar Donde Tu Negocio Más lo Necesita.',
    body: "Empieza con un problema. Agrega más conforme tu negocio crece. Construyo sistemas de IA prácticos alrededor del trabajo que te quita tiempo o te cuesta clientes.",
    pillars: [
      {
        title: "Asistente de Mensajería con IA",
        desc: "Contesta preguntas y capta prospectos en Messenger y en tu sitio web — incluso cuando tú no puedes. Español e inglés, 24/7.",
        icon: "M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z",
        href: "/es/messenger-assistant/",
        linkLabel: "Ver la demo en vivo",
        badge: "En vivo"
      },
      {
        title: "Agente de Voz con IA",
        desc: "Contesta llamadas, califica prospectos y agenda citas sin dejar a nadie esperando. Voz natural, bilingüe, 24/7.",
        icon: "M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z",
        href: "/es/voice-agent/",
