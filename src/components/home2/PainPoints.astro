---
import Container from '../layout/Container.astro';

interface Props {
  locale: 'en' | 'es';
}

const { locale } = Astro.props;

const content = {
  en: {
    heading: "Does This Sound Like Your Business?",
    closing:
      "Every unanswered message can become a lost customer. Every hour spent on repetitive work is time you could spend growing your business.",
    ctaLabel: "See What AI Could Handle for You",
    pains: [
      {
        title: "The Same Questions, All Day",
        desc: "\u201CHow much does it cost?\u201D \u201CAre you open?\u201D \u201CDo you have availability?\u201D You and your team answer the same questions again and again."
      },
      {
        title: "Messages Arrive While You're Busy",
        desc: "Customers write while you're helping someone else, driving, working, or running the business. By the time you look, hours have passed."
      },
      {
        title: "Leads Disappear After Hours",
        desc: "Someone contacts you at 9:30 PM. By morning they may already have contacted your competitor \u2014 and you never knew they were interested."
      },
      {
        title: "Calls Interrupt Your Work",
        desc: "The phone rings while you're with a customer. Answer it and you interrupt the person in front of you; ignore it and you may lose the lead."
      },
      {
        title: "Appointments Need Follow-Up",
        desc: "Confirmations and reminders take time, and every missed appointment leaves empty space on your calendar that someone else could have filled."
      },
      {
        title: "Customers Contact You Everywhere",
        desc: "WhatsApp, Messenger, Instagram, your website, the phone \u2014 keeping up with every channel quietly becomes another job on top of the one you have."
      }
    ]
  },
  es: {
    heading: "\u00BFEsto Te Suena Como Tu Negocio?",
    closing:
      "Cada mensaje sin responder puede convertirse en un cliente perdido. Cada hora en trabajo repetitivo es tiempo que podr\u00EDas dedicar a hacer crecer tu negocio.",
    ctaLabel: "Ve Qu\u00E9 Podr\u00EDa Atender la IA por Ti",
    pains: [
      {
        title: "Las Mismas Preguntas, Todo el D\u00EDa",
        desc: "\u201C\u00BFCu\u00E1nto cuesta?\u201D \u201C\u00BFEst\u00E1n abiertos?\u201D \u201C\u00BFTienen disponibilidad?\u201D T\u00FA y tu equipo contestan lo mismo una y otra vez."
      },
      {
        title: "Los Mensajes Llegan Cuando Est\u00E1s Ocupado",
        desc: "Tus clientes escriben mientras atiendes a alguien m\u00E1s, manejas, trabajas o sacas adelante el negocio. Cuando alcanzas a ver, ya pasaron horas."
      },
      {
        title: "Los Prospectos Desaparecen Fuera de Horario",
        desc: "Alguien te escribe a las 9:30 de la noche. Para la ma\u00F1ana ya pudo haber contactado a tu competencia \u2014 y nunca supiste que estaba interesado."
      },
      {
        title: "Las Llamadas Interrumpen Tu Trabajo",
        desc: "Suena el tel\u00E9fono mientras est\u00E1s con un cliente. Si contestas, interrumpes a quien tienes enfrente; si no, puedes perder al prospecto."
      },
      {
        title: "Las Citas Necesitan Seguimiento",
        desc: "Confirmar y recordar citas toma tiempo, y cada cita perdida deja un hueco en tu agenda que alguien m\u00E1s pudo haber ocupado."
      },
      {
        title: "Tus Clientes Te Buscan por Todos Lados",
        desc: "WhatsApp, Messenger, Instagram, tu sitio web, el tel\u00E9fono \u2014 estar al pendiente de cada canal se vuelve otro trabajo encima del que ya tienes."
      }
    ]
  }
};

const t = content[locale];
---

<section id="pain-points" aria-labelledby="pain-points-heading" class="py-20 md:py-28 bg-gray-50 dark:bg-gray-900/30 scroll-mt-4">
  <Container size="lg">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 id="pain-points-heading" class="font-display text-3xl md:text-4xl font-bold text-gray-900 dark:text-white leading-tight">
        {t.heading}
      </h2>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8 mb-16">
      {t.pains.map((pain, _i) => (
        <div class="group p-6 rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900/50 hover:border-cush-orange/50 hover:shadow-lg hover:shadow-cush-orange/5 transition-all duration-300">
          <div class="w-12 h-12 rounded-lg bg-cush-orange/10 flex items-center justify-center mb-5 group-hover:bg-cush-orange group-hover:text-black dark:text-white text-gray-900 transition-colors duration-300">
            <svg class="w-6 h-6 text-accent-text group-hover:text-black transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          </div>
          <h3 class="font-display font-semibold text-xl text-gray-900 dark:text-white mb-3 tracking-tight">
            {pain.title}
          </h3>
          <p class="text-base text-gray-600 dark:text-gray-400 leading-relaxed">
            {pain.desc}
          </p>
        </div>
      ))}
    </div>

    <div class="max-w-4xl mx-auto text-center p-8 rounded-xl bg-linear-to-br from-cush-orange/5 to-transparent border border-cush-orange/20">
      <p class="font-display font-semibold text-xl md:text-2xl text-gray-900 dark:text-white leading-relaxed mb-6">
        {t.closing}
      </p>
      <a
        href={locale === 'es' ? '/es/reservar/' : '/consultation/'}
        class="inline-flex items-center gap-2 px-6 py-3 bg-cush-orange text-black font-display font-semibold rounded-lg hover:bg-cush-orange/90 transition-all duration-300 shadow-lg shadow-cush-orange/25 group"
      >
        {/* Was "Let's Talk About Your Business" — generic, and disconnected from the six
            problems the reader just recognised themselves in. This label answers the
            question the section just raised. Localised via the dictionary rather than a
            ternary so the two languages cannot drift apart. */}
        {t.ctaLabel}
        <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </Container>
</section>
