---
import Container from '../layout/Container.astro';

interface Props {
  locale: 'en' | 'es';
}

const { locale } = Astro.props;

const content = {
  en: {
    heading: "Recent Client & Production Work",
    projects: [
      {
        title: "AI Voice Agent Platform",
        tags: "AI Voice · Lead Qualification · Appointment Booking",
        desc: "Answers the phone 24/7, works out what the caller needs, books the appointment, and passes on the ones that need you — fast enough that nobody notices a pause.",
        image: "/images/portfolio/thumbs/voice-cushlabs-thumb.webp",
        link: "/projects/cushlabs-ai-voice-agent/"
      },
      {
        title: "Converso AI",
        tags: "AI Chat · Customer Support · Bilingual EN/ES",
        desc: "A chat assistant service businesses can run themselves — answers from their own prices and policies, in English or Spanish, with a human takeover whenever they want it.",
        image: "/images/portfolio/thumbs/ai-chatbot-saas-thumb.webp",
        link: "/projects/ai-chatbot-saas/"
      },
      {
        title: "NY AI Chatbot",
        tags: "AI Chat · Lead Capture · Booked Appointments",
        desc: "Turns website visitors into booked sessions for a paying client — answering questions from the business's own content and capturing the ones ready to talk.",
        image: "/images/portfolio/thumbs/ny-ai-chatbot-thumb.webp",
        link: "/projects/ny-ai-chatbot/"
      }
    ],
    cta: "See All Projects →",
    ctaLink: "/portfolio/"
  },
  es: {
    heading: "Trabajo Reciente en Producción",
    projects: [
      {
        title: "Plataforma de Agente de Voz IA",
        tags: "Voz con IA · Calificación de Prospectos · Agendado de Citas",
        desc: "Contesta el teléfono 24/7, entiende qué necesita quien llama, agenda la cita y te pasa las que requieren de ti — tan rápido que nadie nota una pausa.",
        image: "/images/portfolio/thumbs/voice-cushlabs-thumb.webp",
        link: "/es/projects/cushlabs-ai-voice-agent/"
      },
      {
        title: "Converso AI",
        tags: "Chat con IA · Atención a Clientes · Bilingüe ES/EN",
        desc: "Un asistente de chat que los negocios de servicios operan ellos mismos — contesta con sus propios precios y políticas, en español o inglés, y les cede la conversación cuando quieren.",
        image: "/images/portfolio/thumbs/ai-chatbot-saas-thumb.webp",
        link: "/es/projects/ai-chatbot-saas/"
      },
      {
        title: "Chatbot IA NY",
        tags: "Chat con IA · Captación de Prospectos · Citas Agendadas",
        desc: "Convierte visitantes del sitio en sesiones agendadas para un cliente que paga — contesta con el contenido del propio negocio y capta a quienes ya están listos para hablar.",
        image: "/images/portfolio/thumbs/ny-ai-chatbot-thumb.webp",
        link: "/es/projects/ny-ai-chatbot/"
      }
    ],
    cta: "Ver Todos Los Proyectos →",
    ctaLink: "/es/portfolio/"
  }
};

const t = content[locale];
---

<section id="work" aria-labelledby="recent-work-heading" class="py-20 md:py-32 relative">
  <Container size="lg">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-16">
      <h2 id="recent-work-heading" class="font-display font-bold text-3xl md:text-4xl text-gray-900 dark:text-white leading-tight">
        {t.heading}
      </h2>
      <a href={t.ctaLink} class="inline-flex items-center gap-2 text-accent-text font-medium hover:underline text-lg whitespace-nowrap transition-colors duration-300 hover:text-accent-text/80">
        {t.cta}
      </a>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {t.projects.map((project) => (
        <a href={project.link} class="group rounded-xl overflow-hidden border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900/50 hover:border-cush-orange/40 hover:shadow-xl hover:shadow-cush-orange/10 hover:-translate-y-1 transition-all duration-500 ease-out flex flex-col h-full">
          <div class="aspect-[4/3] bg-gray-100 dark:bg-gray-800 relative overflow-hidden shimmer">
            <img
              src={project.image}
              alt={project.title}
              loading="lazy"
              width="760"
              height="570"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out img-fade"
              onload="this.classList.add('loaded');this.parentElement.classList.remove('shimmer')"
            />
          </div>
          <div class="p-6 flex flex-col flex-grow">
            <div class="text-xs font-display font-semibold text-accent-text uppercase tracking-wider mb-2">
              {project.tags}
            </div>
            <h3 class="font-display font-semibold text-xl text-gray-900 dark:text-white mb-3 group-hover:text-accent-text transition-colors duration-500 ease-out">
              {project.title}
            </h3>
            <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed mt-auto">
              {project.desc}
            </p>
          </div>
        </a>
      ))}
    </div>
  </Container>
</section>
