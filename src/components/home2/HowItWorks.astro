---
import Container from '../layout/Container.astro';

interface Props {
  locale: 'en' | 'es';
}

const { locale } = Astro.props;

const content = {
  en: {
    // Heading no longer promises a timeline. "Days, not weeks" contradicted the
    // "2–6 wks — Time to Live" figure in SocialProof on this same page, and had reached
    // the meta description, so it was printing in search results.
    heading: 'From First Call to Working Assistant',
    steps: [
      {
        num: '01',
        title: 'Show Me Your Business',
        // "where AI can realistically help — and where it can't" is doing real work here.
        // voice-dna's comfort zones include "decision clarity and tradeoffs" and its
        // never_do forbids overselling; naming the limit is what makes the rest credible.
        // This step was NOT shortened with the other two for that reason.
        desc: "We start with a free 30-minute call. You show me what's taking your time, where customers are getting lost, and what you'd like to improve. I'll tell you where AI can realistically help — and where it can't."
      },
      {
        num: '02',
        title: 'I Build It Around You',
        desc: 'I build the assistant from your actual services, prices, policies, and customer conversations. You test it yourself and see it working before anything goes live.'
      },
      {
        num: '03',
        title: 'Launch, Measure, Improve',
        // "deflection rate" is gone. It is a support-industry metric that means nothing
        // to a salon or clinic owner, and using it signalled that this page was written
        // for someone else.
        desc: 'We go live with real conversations and track what matters: response time, leads captured, appointments booked, and hours saved. Your free week starts here — the day the assistant goes live, not the day you sign.'
      }
    ],
    addonTitle: 'Ongoing support available',
    addonBody: 'Monthly optimization and maintenance are available as your business evolves.'
  },
  es: {
    // Ver las notas en la versión EN: el encabezado ya no promete un plazo, y
    // "desviación de tickets" se eliminó por ser jerga de la industria de soporte.
    heading: 'Cómo Funciona — De la Idea a la IA Funcionando',
    steps: [
      {
        num: '01',
        title: 'Muéstrame Tu Negocio',
        desc: 'Empezamos con una llamada gratuita de 30 minutos. Me muestras qué te está quitando tiempo, dónde se te pierden clientes y qué te gustaría mejorar. Te digo dónde la IA puede ayudarte de verdad — y dónde no.'
      },
      {
        num: '02',
        title: 'Lo Construyo Alrededor de Ti',
        desc: 'Construyo alrededor de tus servicios, precios, políticas, clientes, lenguaje y forma de trabajar. Revisas el sistema y lo ves funcionando antes de lanzarlo.'
      },
      {
        num: '03',
        title: 'Lanzar, Medir, Mejorar',
        desc: 'Probamos con conversaciones reales, lanzamos y medimos tiempos de respuesta, prospectos captados, citas agendadas y horas ahorradas.'
      }
    ],
    addonTitle: 'Soporte continuo disponible',
    addonBody: 'Optimización y mantenimiento mensuales, conforme tu negocio evoluciona.'
  }
};

const t = content[locale];
---

{/* Top padding trimmed 2026-09-15 to close the gap under SolutionOverview above —
    the two stacked to 256px. Check that section before restoring py-32 here. */}
<section aria-labelledby="how-it-works-heading" class="pt-14 pb-16 md:pt-16 md:pb-20 bg-white dark:bg-black relative">
  <Container size="lg">
    <div class="text-center mb-12">
      <h2 id="how-it-works-heading" class="font-display font-bold text-3xl md:text-4xl text-gray-900 dark:text-white leading-tight text-balance">
        {t.heading}
      </h2>
    </div>

    {/* THREE COLUMNS, replacing the alternating left/right timeline (2026-09-15).
        The timeline put step 1 left, step 2 right and step 3 left with a centre rule,
        which left roughly half the section empty, bounced the eye across the page, and
        — because the odd steps were right-aligned toward the rule and the even one was
        left-aligned — mixed two text alignments in one list. Three columns read in one
        pass and cut the section's height by more than half.

        The rule above each number is a track, not decoration: it is the only thing
        left carrying "these happen in order" now that the vertical line is gone. On
        mobile the columns stack and each keeps its own rule, which still reads as a
        sequence because the numerals are right there. */}
    <ol class="grid gap-10 md:grid-cols-3 md:gap-8 lg:gap-12 list-none p-0 m-0">
      {t.steps.map((step) => (
        <li class="group">
          <div class="h-0.5 w-full bg-linear-to-r from-cush-orange/60 to-cush-orange/5 mb-5"></div>
          <div class="font-display font-bold text-3xl text-accent-text leading-none mb-3">{step.num}</div>
          <h3 class="font-display font-semibold text-xl text-gray-900 dark:text-white mb-2 text-balance">{step.title}</h3>
          <p class="font-body text-gray-600 dark:text-gray-400 leading-relaxed text-base">{step.desc}</p>
        </li>
      ))}
    </ol>

    {/* Was a full-width pill with a pulsing lightning bolt, floating 80px below the
        steps — it read as a system notification rather than part of the process. Now
        it is quiet, close, and aligned to the same left edge as the columns above. */}
    <div class="mt-10 pt-6 border-t border-black/[0.07] dark:border-white/10">
      <p class="font-display text-sm font-semibold text-gray-900 dark:text-white mb-1">{t.addonTitle}</p>
      <p class="font-body text-sm text-muted max-w-prose">{t.addonBody}</p>
    </div>
  </Container>
</section>
