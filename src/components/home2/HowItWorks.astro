---
import Container from '../layout/Container.astro';

interface Props {
  locale: 'en' | 'es';
}

const { locale } = Astro.props;

const content = {
  en: {
    // Heading no longer promises a timeline. "Days, not weeks" contradicted the
    // "2–6 wks — Time to Live" figure in SocialProof on this same page, and had reached
    // the meta description, so it was printing in search results.
    heading: 'How It Works — From Idea to Working AI',
    steps: [
      {
        title: 'Step 1: Understand Your Business',
        // "where AI can realistically help — and where it can't" is doing real work here.
        // voice-dna's comfort zones include "decision clarity and tradeoffs" and its
        // never_do forbids overselling; naming the limit is what makes the rest credible.
        desc: "We start with a free 30-minute call. You show me what's taking your time, where customers are getting lost, and what you'd like to improve. I'll tell you where AI can realistically help — and where it can't."
      },
      {
        title: 'Step 2: Build & Train',
        desc: 'I build the system around your actual business: your services, pricing, policies, customers, language, and workflow. You review it and see it working before launch.'
      },
      {
        title: 'Step 3: Launch & Improve',
        // "deflection rate" is gone. It is a support-industry metric that means nothing
        // to a salon or clinic owner, and using it signalled that this page was written
        // for someone else.
        desc: 'We test it with real conversations, launch it, and measure what happens — response times, leads captured, appointments booked, and hours saved.'
      }
    ],
    addon: 'Want ongoing optimization? I offer monthly retainers to keep your systems sharp as your business evolves.'
  },
  es: {
    // Ver las notas en la versión EN: el encabezado ya no promete un plazo, y
    // "desviación de tickets" se eliminó por ser jerga de la industria de soporte.
    heading: 'Cómo Funciona — De la Idea a la IA Funcionando',
    steps: [
      {
        title: 'Paso 1: Entender Tu Negocio',
        desc: 'Empezamos con una llamada gratuita de 30 minutos. Me muestras qué te está quitando tiempo, dónde se te pierden clientes y qué te gustaría mejorar. Te digo dónde la IA puede ayudarte de verdad — y dónde no.'
      },
      {
        title: 'Paso 2: Construir y Entrenar',
        desc: 'Construyo el sistema alrededor de tu negocio real: tus servicios, precios, políticas, clientes, lenguaje y forma de trabajar. Lo revisas y lo ves funcionando antes de lanzarlo.'
      },
      {
        title: 'Paso 3: Lanzar y Mejorar',
        desc: 'Lo probamos con conversaciones reales, lo lanzamos y medimos qué pasa — tiempos de respuesta, prospectos captados, citas agendadas y horas ahorradas.'
      }
    ],
    addon: '¿Quieres optimización continua? Ofrezco planes mensuales para mantener tus sistemas afinados mientras tu negocio evoluciona.'
  }
};

const t = content[locale];
---

<section aria-labelledby="how-it-works-heading" class="py-20 md:py-32 bg-white dark:bg-black relative">
  <Container size="md">
    <div class="text-center mb-16">
      <h2 id="how-it-works-heading" class="font-display font-bold text-3xl md:text-4xl text-gray-900 dark:text-white leading-tight">
        {t.heading}
      </h2>
    </div>

    <!-- Timeline/Steps Layout -->
    <div class="relative space-y-12 before:absolute before:inset-0 before:ml-5 md:before:ml-[50%] before:-translate-x-px md:before:translate-x-0 before:h-full before:w-0.5 before:bg-linear-to-b before:from-transparent before:via-gray-200 dark:before:via-gray-800 before:to-transparent">
      {t.steps.map((step, index) => (
        <div class={`relative flex items-center justify-between md:justify-normal md:odd:flex-row-reverse group border md:border-none border-gray-100 dark:border-gray-800 rounded-xl p-6 md:p-0 ${index % 2 === 0 ? 'md:pr-[50%]' : 'md:pl-[50%]'}`}>
          <!-- Marker -->
          <div class="flex items-center justify-center w-10 h-10 rounded-full border-4 border-white dark:border-black bg-cush-orange/20 text-accent-text font-bold font-display shadow-xs group-hover:bg-cush-orange group-hover:text-black transition-colors duration-300 z-10 
            absolute left-0 top-6 md:static md:left-auto md:top-auto
            md:absolute md:left-1/2 md:-translate-x-1/2">
            {index + 1}
          </div>
          
          <!-- Content Box -->
          <div class={`w-full md:w-[calc(100%-3rem)] pl-12 md:pl-0 ${index % 2 === 0 ? 'md:pr-12 lg:pr-16 md:text-right' : 'md:pl-12 lg:pl-16 md:text-left'}`}>
            <h3 class="font-display font-semibold text-xl text-gray-900 dark:text-white mb-2">{step.title}</h3>
            <p class="text-gray-600 dark:text-gray-400 leading-relaxed text-base">{step.desc}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Optional Add-On Badge -->
    <div class="mt-20 flex justify-center">
      <div class="inline-flex items-center gap-3 px-6 py-4 bg-gray-50 dark:bg-gray-900/50 border border-gray-200 dark:border-gray-800 rounded-full text-sm font-medium text-gray-700 dark:text-gray-300">
        <svg class="w-5 h-5 text-accent-text animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        <span>{t.addon}</span>
      </div>
    </div>
  </Container>
</section>
