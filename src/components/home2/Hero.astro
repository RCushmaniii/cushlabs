---
import Container from '../layout/Container.astro';

interface Props {
  locale: 'en' | 'es';
}

const { locale } = Astro.props;

const content = {
  en: {
    badge: 'AI Engineering for Small Business · Bilingual EN/ES · Guadalajara → U.S.',
    headline: "AI That Answers Customers When You Can't — Day, Night, and Weekends.",
    subheadline1: 'I build AI systems that answer messages, book appointments, and capture leads while your team sleeps — in English and Spanish, live in days, not weeks.',
    subheadline2: '',
    trustStrip: [
      '35+ projects shipped',
      'Native bilingual EN/ES',
      'Free 1-week trial',
      'Live demo below ↓',
    ],
    ctaPrimary: 'Book a Free 30-min Call',
    ctaSecondary: 'Try the Live Chatbot',
    ctaDemo: 'See a demo for your industry →',
    scrollHint: 'Scroll to explore',
  },
  es: {
    badge: 'Ingeniería de IA para Pymes · Bilingüe EN/ES · Guadalajara → EE.UU.',
    headline: 'IA Que Atiende a Tus Clientes Cuando Tú No Puedes — Día, Noche y Fines de Semana.',
    subheadline1: 'Construyo sistemas de IA que contestan mensajes, agendan citas y capturan leads mientras tu equipo duerme — en español e inglés, en vivo en días, no semanas.',
    subheadline2: '',
    trustStrip: [
      '35+ proyectos entregados',
      'Bilingüe EN/ES nativo',
      'Prueba gratis de 1 semana',
      'Demo en vivo aquí abajo ↓',
    ],
    ctaPrimary: 'Agendar Llamada Gratis — 30 min',
    ctaSecondary: 'Probar el Chatbot en Vivo',
    ctaDemo: 'Ve un demo para tu industria →',
    scrollHint: 'Explorar',
  },
};

const t = content[locale];
---

<section aria-labelledby="hero-heading" class="home-hero relative flex items-center text-slate-50">
  <Container size="lg">
    <div class="text-center max-w-4xl mx-auto">
      <!-- Trust Badge -->
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 border border-white/20 backdrop-blur-sm mb-5 animate-fade-in">
        <span class="w-2 h-2 rounded-full bg-cush-orange animate-pulse"></span>
        <span class="font-display text-sm font-semibold tracking-wide text-white">{t.badge}</span>
      </div>

      <!-- Headline -->
      <h1 id="hero-heading" class="home-h1 font-display font-bold text-white mb-6 animate-fade-in-up">
        {t.headline}
      </h1>

      <!-- Subheadline -->
      <div class="home-sub mb-8 animate-fade-in-up" style="animation-delay: 0.1s;">
        <p class="mb-2 font-medium text-white">{t.subheadline1}</p>
        <p>{t.subheadline2}</p>
      </div>

      <!-- Trust Strip -->
      <div class="flex flex-wrap justify-center gap-x-6 gap-y-3 mb-10 animate-fade-in-up" style="animation-delay: 0.2s;">
        {t.trustStrip.map((item) => (
          <div class="flex items-center gap-2 font-display text-sm font-medium text-slate-200">
            <svg class="w-4 h-4 text-cush-orange" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>{item}</span>
          </div>
        ))}
      </div>

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center animate-fade-in-up" style="animation-delay: 0.3s;">
        <a
          href={locale === 'es' ? '/es/reservar/' : '/consultation/'}
          class="group inline-flex items-center gap-2 px-8 py-4 bg-cush-orange text-white font-display font-semibold rounded-lg hover:bg-cush-orange/90 transition-all duration-300 shadow-lg shadow-cush-orange/25 hover:shadow-xl hover:shadow-cush-orange/30 text-lg"
        >
          {t.ctaPrimary}
          <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        <button
          type="button"
          data-open-chat
          class="group inline-flex items-center gap-2 px-8 py-4 border-2 border-white/30 text-white font-display font-semibold rounded-lg hover:border-cush-orange hover:text-cush-orange transition-all duration-300 text-lg cursor-pointer backdrop-blur-sm"
        >
          {t.ctaSecondary}
          <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </button>
      </div>

      <!-- Tertiary link: interactive industry demo gallery (/demos/) -->
      <div class="mt-5 animate-fade-in-up" style="animation-delay: 0.4s;">
        <a
          href={locale === 'es' ? '/es/demos/' : '/demos/'}
          class="font-display text-sm font-medium text-slate-300 underline underline-offset-4 decoration-white/30 hover:decoration-cush-orange hover:text-white transition-all"
        >{t.ctaDemo}</a>
      </div>
    </div>
  </Container>

  <!-- Scroll chevron — guides visitors into the funnel (the live demo is the next section) -->
  <a
    href="#demo"
    class="absolute bottom-6 left-1/2 -translate-x-1/2 z-10 flex flex-col items-center gap-1.5 text-white/60 hover:text-cush-orange transition-colors group animate-fade-in"
    style="animation-delay: 0.6s;"
    aria-label={t.scrollHint}
  >
    <span class="text-xs font-display font-medium tracking-wider uppercase opacity-80 group-hover:opacity-100 transition-opacity">{t.scrollHint}</span>
    <svg class="w-6 h-6 animate-bounce-subtle" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </a>
</section>

<style>
  /* Full-bleed photo hero — same mechanic as messenger-assistant.astro/whatsapp.astro/
     voice-agent.astro: the photo IS the pitch, dark gradient keeps white text legible.
     This section overrides the site's light/dark theme toggle with a fixed dark
     treatment (matching the other three), since a warm night-interior photo reads
     naturally as a dark section regardless of the visitor's site-wide theme.
     home-hero-v1.webp: a small-business owner (beauty/spa — matches the beauty-spa
     wedge) at home at night, reaching for her phone to find the AI assistant already
     answered a customer's Messenger question and offered to book. Ties directly to
     the headline's "day, night, and weekends" claim. Subject sits left-of-center in
     the source photo, so background-position is biased LEFT (low %) to keep her and
     the phone screen clear of the centered text column — tune against real viewports
     before shipping, same as the other three heroes.
     -v1 suffix is load-bearing: vercel.json serves /images/(.*) as immutable for a
     year, so any replacement needs a NEW FILENAME, not an overwrite. */
  .home-hero {
    min-height: 100svh;
    background-color: #14110d;
    /* Middle stop is the DARKEST here (not the lightest, like the other three heroes) —
       this photo has no clean empty zone for text, so the headline band needs solid
       backing wherever it lands rather than dodging around the subject. */
    background-image:
      linear-gradient(
        to bottom,
        rgba(20, 17, 13, 0.62) 0%,
        rgba(20, 17, 13, 0.72) 45%,
        rgba(20, 17, 13, 0.88) 100%
      ),
      url("/images/home-hero-v1.webp");
    background-size: cover;
    background-position: 32% 58%;
    background-repeat: no-repeat;
  }

  @media (max-aspect-ratio: 1 / 1) {
    .home-hero {
      min-height: 86svh;
      background-position: 38% 50%;
    }
  }

  @media (max-width: 640px) {
    .home-hero {
      min-height: 96svh;
      background-position: 42% 48%;
      background-image:
        linear-gradient(
          to bottom,
          rgba(20, 17, 13, 0.76) 0%,
          rgba(20, 17, 13, 0.82) 45%,
          rgba(20, 17, 13, 0.93) 100%
        ),
        url("/images/home-hero-v1.webp");
    }
  }

  .home-h1 {
    font-size: clamp(30px, 5.4vw, 54px);
    line-height: 1.12;
    letter-spacing: -0.026em;
    max-width: 20ch;
    margin: 0 auto 16px;
    text-shadow: 0 2px 22px rgba(0, 0, 0, 0.5);
  }

  .home-sub {
    color: rgba(255, 255, 255, 0.92);
    font-size: clamp(16px, 2.2vw, 19px);
    max-width: 52ch;
    margin: 0 auto;
    line-height: 1.6;
    text-shadow: 0 1px 14px rgba(0, 0, 0, 0.55);
  }

  @keyframes fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes fade-in-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: fade-in 0.6s ease-out forwards;
  }

  .animate-fade-in-up {
    animation: fade-in-up 0.6s ease-out forwards;
  }

  @keyframes bounce-subtle {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(6px); }
  }

  .animate-bounce-subtle {
    animation: bounce-subtle 2s ease-in-out infinite;
  }
</style>
