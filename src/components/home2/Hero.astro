---
import Container from '../layout/Container.astro';

interface Props {
  locale: 'en' | 'es';
}

const { locale } = Astro.props;

const content = {
  en: {
    badge: 'AI for Small Business · English + Spanish · Guadalajara → U.S.',
    // Robert's line, 2026-08-21. Reader-first: the sentence opens on THEM, not on the
    // product, which is the one thing the previous headline gave away.
    //
    // "AI" stays deliberately. Removing it was considered and rejected: an answering
    // service or a VA could run this line verbatim without it, which collapses the
    // differentiator into a commodity claim and loses the argument on price. voice-dna's
    // `jargon_rule` allows a technical term when it is the most precise language AND the
    // audience understands it — this audience is actively shopping for AI.
    //
    // "I", never "we" — solo-founder access is the asset an agency cannot match, and the
    // About page sells it directly ("the person you hire is the person writing the code").
    //
    // "I put AI to work" over "I make sure": voice-dna `never_do` forbids implying
    // guarantees, and message delivery runs through Meta's platform, which we do not
    // control. "Put AI to work" is also already this brand's phrasing, in both languages.
    headline: 'You Run Your Business. | I Put AI to Work Answering Your Customers.',

    // CHANNELS ARE A CLAIMS SURFACE. Only name what is live TODAY.
    //
    // Instagram: ADVERTISED-COMMITMENTS §2.4 — "must not advertise IG as an available
    // channel on any client-facing surface until that approval lands." The registry has
    // `meta-instagram-messaging-permissions` as not_submitted; there is no pending review.
    //
    // WhatsApp: List 2 (held) as a CUSTOMER channel. What is live is the OWNER alert —
    // WhatsApp messages Robert when a lead is hot — which is why the line below says
    // "alert you", not "answer on WhatsApp". Different claim, and this one is true.
    //
    // Booking: the assistant LINKS to the booking page, it does not book in chat
    // (confirmed by Robert 2026-08-21). The voice agent does book directly, so "send
    // customers straight to your calendar" is true of both without overstating either.
    //
    // "Comments" was in the draft and is out: not in List 1's four themes.
    //
    // Both channels ARE rendered on /pricing/ in the `soon:` array. Naming them here as
    // live would contradict our own pricing page one click away, which reads as bait
    // rather than ambition — and the first paying client asked for Instagram four hours
    // into day one, so she is exactly who would find it.
    subheadline1:
      'I build AI agents that answer questions, capture leads, and send customers straight to your calendar — on Messenger, your website, and by phone. English and Spanish, 24/7.',
    subheadline2: '',
    trustStrip: [
      '35+ Projects Delivered',
      'English + Spanish',
      // "1-week", not "7-day", to match /pricing/ and ADVERTISED-COMMITMENTS verbatim.
      'Free 1-Week Trial',
      'Launch in Days or Weeks — Not Months',
    ],
    ctaPrimary: 'Try the Live Demo',
    ctaSecondary: 'Book a Free 30-Min Call',
    ctaDemo: 'See a Demo for Your Business ↓',
    scrollHint: 'Scroll to explore',
  },
  es: {
    badge: 'IA para Pequeños Negocios · Español + Inglés · Guadalajara → EE. UU.',

    // "Poner la IA a trabajar" es deliberado y NO se debe traducir a algo más literal:
    // presenta la IA como un trabajador práctico y no como tecnología abstracta, que es
    // exactamente el modelo mental que queremos en un prospecto mexicano. Registro "tú",
    // "prospectos" y no "leads" en prosa, "agendar" y no "reservar".
    // Las restricciones de canales están explicadas en la versión EN.
    headline: 'Tú Manejas Tu Negocio. | Yo Pongo la IA a Trabajar Respondiendo a Tus Clientes.',
    subheadline1:
      'Creo agentes de IA que contestan preguntas, captan prospectos y llevan a tus clientes directo a tu calendario — en Messenger, tu sitio web y por teléfono. Español e inglés, 24/7.',
    subheadline2: '',
    trustStrip: [
      'Más de 35 Proyectos Entregados',
      'Español + Inglés',
      // "1 semana", no "7 días", para que coincida con /es/precios/ palabra por palabra.
      'Prueba Gratis de 1 Semana',
      'Listo en Días o Semanas — No Meses',
    ],
    ctaPrimary: 'Prueba la Demo en Vivo',
    ctaSecondary: 'Agenda una Llamada Gratis de 30 Min',
    ctaDemo: 'Ve una Demo para Tu Negocio ↓',
    scrollHint: 'Explorar',
  },
};

const t = content[locale];
---

<section aria-labelledby="hero-heading" class="home-hero relative flex items-center text-slate-50">
  <Container size="lg">
    <div class="text-center max-w-4xl mx-auto">
      <!-- Trust Badge -->
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 border border-white/20 backdrop-blur-sm mb-5 animate-fade-in">
        <span class="w-2 h-2 rounded-full bg-cush-orange animate-pulse"></span>
        <span class="font-display text-sm font-semibold tracking-wide text-white">{t.badge}</span>
      </div>

      {/* The headline is two sentences and the PAUSE between them is the mechanism —
          "you do this / I do that" only lands if the reader sees two halves. Rendered
          as separate lines rather than one wrapped block, where the sentence break fell
          mid-line ("...your business. I put AI to...") and the parallel disappeared.
          A plain \n would not survive HTML whitespace collapsing, so the two halves are
          separate spans. Reads as one sentence to a screen reader either way. */}
      <h1 id="hero-heading" class="home-h1 font-display font-bold text-white mb-6 animate-fade-in-up">
        {t.headline.split(" | ").map((part, i) => (
          <span class:list={["block", i > 0 && "text-white/90"]}>{part}</span>
        ))}
      </h1>

      <!-- Subheadline -->
      <div class="home-sub mb-8 animate-fade-in-up" style="animation-delay: 0.1s;">
        <p class="mb-2 font-medium text-white">{t.subheadline1}</p>
        <p>{t.subheadline2}</p>
      </div>

      <!-- Trust Strip -->
      <div class="flex flex-wrap justify-center gap-x-6 gap-y-3 mb-10 animate-fade-in-up" style="animation-delay: 0.2s;">
        {t.trustStrip.map((item) => (
          <div class="flex items-center gap-2 font-display text-sm font-medium text-slate-200">
            <svg class="w-4 h-4 text-accent-text" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>{item}</span>
          </div>
        ))}
      </div>

      <!-- CTA Buttons -->
      {/* PRIMARY is now the demo, SECONDARY is the call (swapped 2026-08-21). The ACTIONS
          moved with the labels, not just the text — leaving them in place would have
          pointed "Try the Live Demo" at the booking page. Demo-first lowers the
          commitment of the first click: trying something costs nothing, booking a call
          costs a calendar slot and a conversation. */}
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center animate-fade-in-up" style="animation-delay: 0.3s;">
        <button
          type="button"
          data-open-chat
          class="group inline-flex items-center gap-2 px-8 py-4 bg-cush-orange text-black font-display font-semibold rounded-lg hover:bg-cush-orange/90 transition-all duration-300 shadow-lg shadow-cush-orange/25 hover:shadow-xl hover:shadow-cush-orange/30 text-lg cursor-pointer"
        >
          {t.ctaPrimary}
          <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </button>
        <a
          href={locale === 'es' ? '/es/reservar/' : '/consultation/'}
          class="group inline-flex items-center gap-2 px-8 py-4 border-2 border-white/30 text-white font-display font-semibold rounded-lg hover:border-cush-orange hover:text-accent-text transition-all duration-300 text-lg backdrop-blur-sm"
        >
          {t.ctaSecondary}
          <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

      <!-- Tertiary link: interactive industry demo gallery (/demos/) -->
      <div class="mt-5 animate-fade-in-up" style="animation-delay: 0.4s;">
        <a
          href={locale === 'es' ? '/es/demos/' : '/demos/'}
          class="font-display text-sm font-medium text-slate-300 underline underline-offset-4 decoration-white/30 hover:decoration-cush-orange hover:text-white transition-all"
        >{t.ctaDemo}</a>
      </div>
    </div>
  </Container>

  <!-- Scroll chevron — guides visitors into the funnel (the live demo is the next section) -->
  <a
    href="#demo"
    class="absolute bottom-6 left-1/2 -translate-x-1/2 z-10 flex flex-col items-center gap-1.5 text-white/60 hover:text-accent-text transition-colors group animate-fade-in"
    style="animation-delay: 0.6s;"
    aria-label={t.scrollHint}
  >
    <span class="text-xs font-display font-medium tracking-wider uppercase opacity-80 group-hover:opacity-100 transition-opacity">{t.scrollHint}</span>
    <svg class="w-6 h-6 animate-bounce-subtle" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </a>
</section>

<style>
  /* Full-bleed photo hero — same mechanic as messenger-assistant.astro/whatsapp.astro/
     voice-agent.astro: the photo IS the pitch, dark gradient keeps white text legible.
     This section overrides the site's light/dark theme toggle with a fixed dark
     treatment (matching the other three), since a warm night-interior photo reads
     naturally as a dark section regardless of the visitor's site-wide theme.
     home-hero-v1.webp: a small-business owner (beauty/spa — matches the beauty-spa
     wedge) at home at night, reaching for her phone to find the AI assistant already
     answered a customer's Messenger question and offered to book.

     NOTE 2026-08-21: this photo was chosen to illustrate the OLD headline's "day,
     night, and weekends" phrase, which the new headline drops. It still earns its
     place — the subheadline's "while you're with a customer, closing up, or asleep"
     carries the same idea, and the image now does that work visually instead of the
     headline doing it in words. If the subheadline ever loses that clause, revisit
     the photo too, or it becomes a night shot illustrating nothing.

     Subject sits left-of-center in
     the source photo, so background-position is biased LEFT (low %) to keep her and
     the phone screen clear of the centered text column — tune against real viewports
     before shipping, same as the other three heroes.
     -v1 suffix is load-bearing: vercel.json serves /images/(.*) as immutable for a
     year, so any replacement needs a NEW FILENAME, not an overwrite. */
  .home-hero {
    min-height: 100svh;
    background-color: #14110d;
    /* Middle stop is the DARKEST here (not the lightest, like the other three heroes) —
       this photo has no clean empty zone for text, so the headline band needs solid
       backing wherever it lands rather than dodging around the subject. */
    background-image:
      linear-gradient(
        to bottom,
        rgba(20, 17, 13, 0.62) 0%,
        rgba(20, 17, 13, 0.72) 45%,
        rgba(20, 17, 13, 0.88) 100%
      ),
      url("/images/home-hero-v1.webp");
    background-size: cover;
    background-position: 32% 58%;
    background-repeat: no-repeat;
  }

  @media (max-aspect-ratio: 1 / 1) {
    .home-hero {
      min-height: 86svh;
      background-position: 38% 50%;
    }
  }

  @media (max-width: 640px) {
    .home-hero {
      min-height: 96svh;
      background-position: 42% 48%;
      background-image:
        linear-gradient(
          to bottom,
          rgba(20, 17, 13, 0.76) 0%,
          rgba(20, 17, 13, 0.82) 45%,
          rgba(20, 17, 13, 0.93) 100%
        ),
        url("/images/home-hero-v1.webp");
    }
  }

  .home-h1 {
    font-size: clamp(30px, 5.4vw, 54px);
    line-height: 1.12;
    letter-spacing: -0.026em;
    max-width: 20ch;
    margin: 0 auto 16px;
    text-shadow: 0 2px 22px rgba(0, 0, 0, 0.5);
  }

  .home-sub {
    color: rgba(255, 255, 255, 0.92);
    font-size: clamp(16px, 2.2vw, 19px);
    max-width: 52ch;
    margin: 0 auto;
    line-height: 1.6;
    text-shadow: 0 1px 14px rgba(0, 0, 0, 0.55);
  }

  @keyframes fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes fade-in-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: fade-in 0.6s ease-out forwards;
  }

  .animate-fade-in-up {
    animation: fade-in-up 0.6s ease-out forwards;
  }

  @keyframes bounce-subtle {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(6px); }
  }

  .animate-bounce-subtle {
    animation: bounce-subtle 2s ease-in-out infinite;
  }
</style>
