---
import Container from '../layout/Container.astro';
import { whatsappBookingHref } from '../../lib/whatsapp-booking';

interface Props {
  locale: 'en' | 'es';
}

const { locale } = Astro.props;

const content = {
  en: {
    // The badge is now the single home of the two facts the hero repeated three times
    // (badge + subheadline + trust strip): bilingual, and always-on. Consolidated here
    // 2026-09-15 rather than deleted, because it sits above the headline in a pulsing
    // pill — the most prominent position in the hero.
    //
    // "Guadalajara → U.S." is OUT. It was ambiguous on first read (based in Guadalajara?
    // serving the U.S.? both?) and an ambiguous badge costs more than the geo signal it
    // bought. The geo signal is not lost: BaseLayout.astro emits addressLocality
    // "Guadalajara" in LocalBusiness schema, and /about/ states the base in prose on both
    // locales. Do not re-add it here to "help SEO" — a decorative pill is not where that
    // ranking comes from.
    //
    // "24/7" is an approved claim: ADVERTISED-COMMITMENTS §4 Theme 1, "Replies in under
    // 5 seconds, 24/7 — nights, weekends, holidays."
    badge: 'AI for Small Business · English + Spanish · 24/7',
    // Robert's approved copy, 2026-10-09. The headline sells the outcome (an answer in
    // seconds, at the hour nobody is at the desk); the subheadline says exactly what is
    // installed, where, and what it costs.
    //
    // "in seconds" is a verified List 1 claim: ADVERTISED-COMMITMENTS §4 Theme 1,
    // "Replies in under 5 seconds, 24/7". No "typically" needed — claims-policy level 1.
    //
    // CHANNELS AND BOOKING ARE A CLAIMS SURFACE. The assistant lives on Facebook; the
    // OWNER is alerted on WhatsApp ("sends you a WhatsApp alert"), which is live. An AI
    // answering customers ON WhatsApp is not offered. "ready to book" is deliberate: on
    // Messenger the assistant captures the lead and sends the booking link — it does not
    // book into a calendar itself (SESSION_LOG debt #29). Do not write "books
    // appointments" here.
    //
    // Price and trial wording must match commercial-terms.json verbatim ($129 USD/mo,
    // "1-week free trial") — `npm run validate:terms` reads this surface.
    //
    // " | " splits the headline into two rendered lines; the pause is the point. The
    // a non-breaking space before the dash keeps it on the first line — without it the dash wrapped
    // onto a line of its own at 1440px in Spanish.
    headline: 'Your customers get an answer in seconds — | even at 10 p.m.',
    subheadline1:
      "I put an AI assistant on your Facebook Page that answers with your real prices and hours, in Spanish or English, and sends you a WhatsApp alert when someone's ready to book. From $129 USD/mo · free 1-week trial.",
    // THREE items, not four — four wrapped to two rows at laptop width. Cut before you add.
    // "35+ Projects Delivered" was replaced 2026-10-09: unverifiable. The Praxair/Linde line
    // is claims-policy biographical_facts approved wording.
    trustStrip: [
      'Fortune 500 IT leadership (Praxair/Linde)',
      // "1-week", not "7-day", to match /pricing/ and ADVERTISED-COMMITMENTS verbatim.
      'Free 1-Week Trial',
      'No Long-Term Contract',
    ],
    ctaPrimary: 'Try the Live Demo',
    ctaSecondary: 'Book a Free 30-Min Call',
    // Rendered only on the Spanish hero; kept here so both locales share one shape.
    ctaWhatsApp: 'Book on WhatsApp — under a minute',
    ctaDemo: 'See a Demo for Your Business ↓',
    scrollHint: 'Scroll to explore',
  },
  es: {
    badge: 'IA para Pequeños Negocios · Español + Inglés · 24/7',

    // Copia aprobada por Robert, 2026-10-09. Las restricciones de canales y de agendado
    // están explicadas en la versión EN. Registro "tú", primera persona singular ("Pongo"),
    // "agendar" y no "reservar". Precio y prueba tal cual commercial-terms.json.
    headline: 'Tus clientes reciben respuesta en segundos — | aunque te escriban a las 10 de la noche.',
    subheadline1:
      'Pongo un asistente con IA en tu página de Facebook que contesta con tus precios y horarios reales, en español o inglés, y te avisa por WhatsApp cuando alguien está listo para agendar. Desde $1,990 MXN/mes + IVA · prueba gratis de 1 semana.',
    trustStrip: [
      'Liderazgo de TI en Fortune 500 (Praxair/Linde)',
      // "1 semana", no "7 días", para que coincida con /es/precios/ palabra por palabra.
      'Prueba Gratis de 1 Semana',
      'Sin Contrato Forzoso',
    ],
    ctaPrimary: 'Prueba la Demo en Vivo',
    ctaSecondary: 'Agenda una Llamada Gratis de 30 Min',
    // Primary CTA on the Spanish hero (2026-10-09): a Spanish visitor books in under a
    // minute on WhatsApp, the same Flow /es/reservar/ offers. The calendar call is second.
    ctaWhatsApp: 'Agenda por WhatsApp — menos de un minuto',
    ctaDemo: 'Ve una Demo para Tu Negocio ↓',
    scrollHint: 'Explorar',
  },
};

const t = content[locale];
const isEs = locale === 'es';
const waHref = whatsappBookingHref('es');
---

<section aria-labelledby="hero-heading" class="home-hero relative flex items-center text-slate-50">
  {/* The hand-off to the demo section. The photo used to end on a hard edge against
      white, which read as two different websites stacked. This fades the bottom 160px
      into the exact colour the next section is painted in — they share
      --color-demo-surface, so the seam cannot drift.
      aria-hidden + pointer-events-none: decorative, and it must not eat clicks on the
      scroll chevron that sits inside it. */}
  <div class="home-hero__fade" aria-hidden="true"></div>
  <Container size="lg">
    <div class="text-center max-w-4xl mx-auto">
      <!-- Trust Badge -->
      <div class="home-badge inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 border border-white/20 backdrop-blur-sm mb-5 animate-fade-in">
        <span class="w-2 h-2 rounded-full bg-cush-orange animate-pulse"></span>
        <span class="font-display text-sm font-semibold tracking-wide text-white">{t.badge}</span>
      </div>

      {/* The headline is two sentences and the PAUSE between them is the mechanism —
          "you do this / I do that" only lands if the reader sees two halves. Rendered
          as separate lines rather than one wrapped block, where the sentence break fell
          mid-line ("...your business. I put AI to...") and the parallel disappeared.
          A plain \n would not survive HTML whitespace collapsing, so the two halves are
          separate spans. Reads as one sentence to a screen reader either way. */}
      <h1 id="hero-heading" class="home-h1 font-display font-bold text-white mb-6 animate-fade-in-up">
        {t.headline.split(" | ").map((part, i) => (
          <span class:list={["block", i > 0 && "text-white/90"]}>{part}</span>
        ))}
      </h1>

      <!-- Subheadline -->
      {/* Bottom spacing lives in the .home-sub rule below, NOT in a Tailwind mb-*
          class — the scoped `margin` shorthand outranks it and silently zeroes it out.
          A mb-8 here looks like it works and does nothing. Measured, 2026-09-15. */}
      <div class="home-sub animate-fade-in-up" style="animation-delay: 0.1s;">
        <p class="font-medium text-white">{t.subheadline1}</p>
      </div>

      <!-- Trust Strip -->
      <div class="home-trust flex flex-wrap justify-center gap-x-6 gap-y-3 mb-10 animate-fade-in-up" style="animation-delay: 0.2s;">
        {t.trustStrip.map((item) => (
          <div class="flex items-center gap-2 font-display text-sm font-medium text-slate-200">
            <svg class="w-4 h-4 text-accent-text" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>{item}</span>
          </div>
        ))}
      </div>

      <!-- CTA Buttons -->
      {/* PRIMARY is the CALL again, SECONDARY the demo (Robert, 2026-10-07) — reversing
          the 2026-08-21 swap. Why the reasoning changed: (1) the live chat demo is the
          very next section on this page, so a demo-first hero button mostly duplicated
          it; (2) booking used to be the expensive first click (form + calendar), but
          since 2026-10-06 a Spanish visitor books in under a minute on WhatsApp from
          the booking page; (3) consultations are where the sale closes. The ACTIONS
          moved with the styles, not just the labels.
          `t.ctaSecondary` is the call label and `t.ctaPrimary` the demo label — the
          key names predate this swap; the order below is what renders.
          2026-10-09: on the SPANISH hero WhatsApp booking becomes the primary button,
          the calendar call the secondary, and the demo drops to a text link below.
          English is unchanged: call primary, demo secondary. */}
      <div class="home-ctas flex flex-col sm:flex-row gap-4 justify-center items-center animate-fade-in-up" style="animation-delay: 0.3s;">
        {isEs && (
          /* ES primary (2026-10-09): WhatsApp booking, same deep link and event name as
             the card on /es/reservar/ — only the placement differs. */
          <a
            href={waHref}
            target="_blank"
            rel="noopener noreferrer"
            data-analytics-event="whatsapp_booking_clicked"
            data-analytics-placement="homepage-hero"
            class="group inline-flex items-center gap-2 px-8 py-4 bg-cush-orange text-black font-display font-semibold rounded-lg hover:bg-cush-orange/90 transition-all duration-300 shadow-lg shadow-cush-orange/25 hover:shadow-xl hover:shadow-cush-orange/30 text-lg"
          >
            {t.ctaWhatsApp}
          </a>
        )}
        <a
          href={isEs ? '/es/reservar/' : '/consultation/'}
          data-analytics-event="booking_cta_clicked"
          data-analytics-placement="homepage-hero"
          class:list={[
            "group inline-flex items-center gap-2 px-8 py-4 font-display font-semibold rounded-lg transition-all duration-300 text-lg",
            isEs
              ? "border-2 border-white/30 text-white hover:border-cush-orange hover:text-accent-text backdrop-blur-sm"
              : "bg-cush-orange text-black hover:bg-cush-orange/90 shadow-lg shadow-cush-orange/25 hover:shadow-xl hover:shadow-cush-orange/30",
          ]}
        >
          {t.ctaSecondary}
          <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        {!isEs && (
          <button
            type="button"
            data-open-chat
            data-analytics-event="demo_opened"
            data-analytics-placement="homepage-hero"
            class="group inline-flex items-center gap-2 px-8 py-4 border-2 border-white/30 text-white font-display font-semibold rounded-lg hover:border-cush-orange hover:text-accent-text transition-all duration-300 text-lg backdrop-blur-sm cursor-pointer"
          >
            {t.ctaPrimary}
            <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </button>
        )}
      </div>

      <!-- Tertiary link: interactive industry demo gallery (/demos/) -->
      <div class="mt-5 flex flex-wrap justify-center gap-x-5 gap-y-2 animate-fade-in-up" style="animation-delay: 0.4s;">
        {isEs && (
          /* The live chat demo moves down to a text link on the Spanish hero, where the
             two buttons are WhatsApp booking and the calendar call. Same event. */
          <button
            type="button"
            data-open-chat
            data-analytics-event="demo_opened"
            data-analytics-placement="homepage-hero"
            class="font-display text-sm font-medium text-slate-300 underline underline-offset-4 decoration-white/30 hover:decoration-cush-orange hover:text-white transition-all cursor-pointer"
          >{t.ctaPrimary}</button>
        )}
        <a
          href={locale === 'es' ? '/es/demos/' : '/demos/'}
          class="font-display text-sm font-medium text-slate-300 underline underline-offset-4 decoration-white/30 hover:decoration-cush-orange hover:text-white transition-all"
        >{t.ctaDemo}</a>
      </div>
    </div>
  </Container>

  {/* The "SCROLL TO EXPLORE" chevron was REMOVED 2026-09-15 when the demo section
      began overlapping the hero's bottom 48px — it sat at bottom-6 and is ~40px tall,
      so the overlap cut it in half, and raising it pushed it into the CTA buttons
      (the hero text column already ends ~112px from the bottom at 1440x900). The
      bottom fade plus the rounded sheet lifting off the photograph is now the scroll
      affordance. `t.scrollHint` is kept in the content object: it is still the
      accessible name for the hero region's hand-off and costs nothing to hold. */}
</section>

<style>
  /* Full-bleed photo hero — same mechanic as messenger-assistant.astro/whatsapp.astro/
     voice-agent.astro: the photo IS the pitch, dark gradient keeps white text legible.
     This section overrides the site's light/dark theme toggle with a fixed dark
     treatment (matching the other three), since a warm night-interior photo reads
     naturally as a dark section regardless of the visitor's site-wide theme.
     home-hero-v1.webp: a small-business owner (beauty/spa — matches the beauty-spa
     wedge) at home at night, reaching for her phone to find the AI assistant already
     answered a customer's Messenger question and offered to book.

     NOTE 2026-08-21, corrected 2026-09-15: this photo was chosen to illustrate the OLD
     headline's "day, night, and weekends" phrase, which the current headline drops. The
     note used to claim the subheadline carried the idea with "while you're with a
     customer, closing up, or asleep" — that clause was already gone when the note was
     written, so it was wrong on the day it shipped. What carries the always-on idea now
     is "24/7" in the badge, still above the headline and still above the fold. If 24/7
     ever leaves the hero entirely, revisit this photo or it becomes a night shot
     illustrating nothing.

     Subject sits left-of-center in
     the source photo, so background-position is biased LEFT (low %) to keep her and
     the phone screen clear of the centered text column — tune against real viewports
     before shipping, same as the other three heroes.
     -v1 suffix is load-bearing: vercel.json serves /images/(.*) as immutable for a
     year, so any replacement needs a NEW FILENAME, not an overwrite. */
  .home-hero__fade {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 160px;
    pointer-events: none;
    z-index: 1;
    background: linear-gradient(
      to bottom,
      rgba(var(--demo-surface) / 0) 0%,
      rgba(var(--demo-surface) / 0.55) 62%,
      rgb(var(--demo-surface)) 100%
    );
  }

  .home-hero {
    min-height: 100svh;
    background-color: #14110d;
    /* Middle stop is the DARKEST here (not the lightest, like the other three heroes) —
       this photo has no clean empty zone for text, so the headline band needs solid
       backing wherever it lands rather than dodging around the subject. */
    background-image:
      linear-gradient(
        to bottom,
        rgba(20, 17, 13, 0.62) 0%,
        rgba(20, 17, 13, 0.72) 45%,
        rgba(20, 17, 13, 0.88) 100%
      ),
      url("/images/home-hero-v1.webp");
    background-size: cover;
    background-position: 32% 58%;
    background-repeat: no-repeat;
  }

  @media (max-aspect-ratio: 1 / 1) {
    .home-hero {
      min-height: 86svh;
      background-position: 38% 50%;
    }
  }

  @media (max-width: 640px) {
    .home-hero {
      min-height: 96svh;
      background-position: 42% 48%;
      background-image:
        linear-gradient(
          to bottom,
          rgba(20, 17, 13, 0.76) 0%,
          rgba(20, 17, 13, 0.82) 45%,
          rgba(20, 17, 13, 0.93) 100%
        ),
        url("/images/home-hero-v1.webp");
    }
  }

  .home-h1 {
    font-size: clamp(30px, 5.4vw, 54px);
    line-height: 1.12;
    letter-spacing: -0.026em;
    max-width: 20ch;
    margin: 0 auto 16px;
    text-shadow: 0 2px 22px rgba(0, 0, 0, 0.5);
  }

  .home-sub {
    color: rgba(255, 255, 255, 0.92);
    font-size: clamp(16px, 2.2vw, 19px);
    max-width: 52ch;
    /* The bottom value is load-bearing: it is the only gap between the paragraph and
       the proof row. It was 0 until 2026-09-15 because a Tailwind mb-8 on the element
       was being overridden by this shorthand, which is why the hero read as crowded. */
    margin: 0 auto 28px;
    line-height: 1.6;
    text-shadow: 0 1px 14px rgba(0, 0, 0, 0.55);
  }

  @keyframes fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes fade-in-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: fade-in 0.6s ease-out forwards;
  }

  .animate-fade-in-up {
    animation: fade-in-up 0.6s ease-out forwards;
  }

  @keyframes bounce-subtle {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(6px); }
  }

  .animate-bounce-subtle {
    animation: bounce-subtle 2s ease-in-out infinite;
  }
  /* Phone layout (2026-10-07, Robert: "my home page mobile is ugly"). Layout only —
     the copy above has claim decisions behind every word, so nothing here changes
     wording. What was wrong at 390px: the badge wrapped to two lines, a four-line
     30px headline, a heavy 19px paragraph, the trust ticks stacked down the middle
     with ragged indents, two buttons of different widths (the second wrapping), and
     the vertically centred block pushing the buttons under the floating chat bubble.
     Desktop is untouched. */
  @media (max-width: 640px) {
    /* Last in the sheet on purpose: the base .home-h1/.home-sub rules and the
       96svh min-height above would otherwise win on source order. */
    .home-hero {
      align-items: flex-start;
      min-height: 0;
      padding-top: 28px;
      padding-bottom: 120px; /* clears the fixed chat bubble; the demo sheet overlaps the last 48px */
    }
    .home-badge {
      padding: 6px 12px;
      margin-bottom: 18px;
    }
    .home-badge span:last-child {
      font-size: 11.5px;
      white-space: nowrap;
      letter-spacing: 0.01em;
    }
    .home-h1 {
      font-size: 27px;
      line-height: 1.15;
      letter-spacing: -0.01em;
      margin-bottom: 14px;
    }
    .home-sub {
      font-size: 15px;
      line-height: 1.55;
      margin-bottom: 20px;
    }
    .home-sub p {
      font-weight: 400;
      color: rgb(255 255 255 / 0.86);
    }
    .home-trust {
      column-gap: 14px;
      row-gap: 6px;
      margin-bottom: 26px;
    }
    .home-trust > div {
      font-size: 13px;
      gap: 6px;
    }
    .home-ctas {
      gap: 12px;
    }
    .home-ctas > * {
      width: 100%;
      justify-content: center;
      padding-top: 14px;
      padding-bottom: 14px;
      font-size: 15.5px;
      white-space: nowrap;
      padding-left: 16px;
      padding-right: 16px;
    }
  }
</style>
