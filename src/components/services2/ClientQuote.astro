---
/**
 * One real client quote. Used on the services page (before the FAQ) and on the
 * Messenger assistant page (before the related reading).
 *
 * Why it exists (2026-10-19): the services page is the deepest sales page on the
 * site and carried no proof at all — four service blocks, a process, a fit
 * check, an FAQ, and not one sentence from a customer. The quote comes from
 * src/data/testimonials.ts, the only source of quotes anywhere on the site, and
 * it is about the Messenger assistant: the product every plan on this page
 * starts with. Deliberately ONE quote and no metrics block. The homepage
 * SocialProof section already carries the full case study, and this page is
 * long enough.
 */
import Container from '../layout/Container.astro';
import { getTestimonial } from '../../data/testimonials';

interface Props {
  locale: 'en' | 'es';
}

const { locale } = Astro.props;

const quote = getTestimonial('azucena-carrillo');
const label = { en: 'From a client', es: 'De una clienta' }[locale];
---

<section class="py-16 md:py-20 bg-gray-50 dark:bg-gray-900/30" aria-labelledby="services-client-quote">
  <Container size="md">
    <figure class="max-w-3xl mx-auto p-8 md:p-10 rounded-2xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900">
      <p id="services-client-quote" class="font-display text-sm font-semibold uppercase tracking-wider text-accent-text mb-4">
        {label}
      </p>
      <blockquote class="text-lg md:text-xl text-gray-700 dark:text-gray-300 leading-relaxed">
        &ldquo;{quote.quote[locale]}&rdquo;
      </blockquote>
      <figcaption class="flex items-center gap-3 mt-6 pt-6 border-t border-gray-100 dark:border-gray-800">
        <div class="w-10 h-10 rounded-full bg-cush-orange/15 flex items-center justify-center shrink-0 font-display font-bold text-sm text-accent-text" aria-hidden="true">
          {quote.initials}
        </div>
        <div>
          <div class="font-display font-semibold text-sm text-gray-900 dark:text-white">{quote.name}</div>
          {quote.org && (quote.orgUrl ? (
            <a href={quote.orgUrl} target="_blank" rel="noopener noreferrer" class="block text-xs text-gray-500 dark:text-gray-400 underline decoration-dotted underline-offset-2 hover:text-accent-text">{quote.org}</a>
          ) : (
            <div class="text-xs text-gray-500 dark:text-gray-400">{quote.org}</div>
          ))}
          <div class="text-xs text-accent-text">{quote.source[locale]}</div>
        </div>
      </figcaption>
    </figure>
  </Container>
</section>
