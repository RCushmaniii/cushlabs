---
/**
 * "Go talk to one" — the reachable demos, on the page named /demos/.
 *
 * Added 2026-08-14. The demos page opened straight into a SIMULATED phone
 * thread (IndustryMessengerDemo) and offered no route to the live assistants,
 * which are the strongest proof asset CushLabs has. This strip sits above the
 * simulator: real first, illustration second.
 *
 * All copy except the section heading is imported from src/data/liveDemos.ts,
 * which is shared with /messenger-assistant/ so the two cannot drift. Claims
 * boundary and the reason the gated demo microsites are excluded are both
 * documented in that file — read it before adding an entry here.
 */
import { allLiveDemos, type Locale } from "../../data/liveDemos";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const demos = allLiveDemos(locale);

const STRINGS = {
  en: {
    kicker: "Live, right now",
    heading: "Stop reading. Go talk to one.",
    sub: "These are production assistants answering real customers — not mockups. Message them, call them, ask them anything you would ask a business you were about to buy from.",
    tryAsking: "Try asking",
  },
  es: {
    kicker: "En vivo, ahora mismo",
    heading: "Deja de leer. Ve y habla con uno.",
    sub: "Estos son asistentes en producción atendiendo clientes reales — no son maquetas. Escríbeles, márcales y pregúntales lo que le preguntarías a un negocio al que estás por comprarle.",
    tryAsking: "Pregúntale",
  },
} as const;

const S = STRINGS[locale];
---

<section class="bg-cush-gray-900 py-20 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="max-w-2xl">
      <p
        class="font-display text-xs font-bold uppercase tracking-[0.16em] text-cush-orange"
      >
        <span
          class="mr-2 inline-block h-2 w-2 animate-pulse rounded-full bg-cush-orange align-middle"
        ></span>
        {S.kicker}
      </p>
      <h2
        class="mt-4 font-display text-3xl font-bold text-white sm:text-4xl"
      >
        {S.heading}
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-gray-300">{S.sub}</p>
    </div>

    <ul class="mt-12 grid gap-6 md:grid-cols-3">
      {
        demos.map((d) => (
          <li class="flex flex-col rounded-xl border border-gray-700 bg-black/40 p-6 transition-colors duration-300 hover:border-cush-orange">
            <span class="font-display text-[11px] font-bold uppercase tracking-[0.14em] text-cush-orange">
              {d.badge}
            </span>
            <h3 class="mt-3 font-display text-xl font-bold text-white">
              {d.name}
            </h3>
            <p class="mt-1 text-sm text-gray-400">{d.tagline}</p>
            <p class="mt-4 flex-grow text-sm leading-relaxed text-gray-300">
              {d.copy}
            </p>

            {d.questions && (
              <div class="mt-5">
                <p class="font-display text-[11px] font-bold uppercase tracking-[0.14em] text-gray-500">
                  {S.tryAsking}
                </p>
                <ul class="mt-2 flex flex-wrap gap-2">
                  {d.questions.slice(0, 3).map((q) => (
                    <li class="rounded-full border border-gray-700 px-3 py-1 text-xs text-gray-300">
                      {q}
                    </li>
                  ))}
                </ul>
              </div>
            )}

            <a
              href={d.href}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-6 block rounded-lg bg-cush-orange px-5 py-3 text-center font-display text-sm font-semibold text-black transition-opacity duration-300 hover:opacity-90"
            >
              {d.cta}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
