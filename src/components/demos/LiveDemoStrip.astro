---
/**
 * "Go talk to one" — the reachable demos, on the page named /demos/.
 *
 * Added 2026-08-14. The demos page opened straight into a SIMULATED phone
 * thread (IndustryMessengerDemo) and offered no route to the live assistants,
 * which are the strongest proof asset CushLabs has. This strip sits above the
 * simulator: real first, illustration second.
 *
 * All copy except the section heading is imported from src/data/liveDemos.ts,
 * which is shared with /messenger-assistant/ so the two cannot drift. Claims
 * boundary and the reason the gated demo microsites are excluded are both
 * documented in that file — read it before adding an entry here.
 */
import { allLiveDemos, type Locale } from "../../data/liveDemos";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const demos = allLiveDemos(locale);

const STRINGS = {
  en: {
    kicker: "Live, right now",
    heading: "Stop reading. Go talk to one.",
    sub: "Real assistants answering real customers. Not mockups.",
  },
  es: {
    kicker: "En vivo, ahora mismo",
    heading: "Deja de leer. Ve y habla con uno.",
    sub: "Asistentes reales atendiendo clientes reales. No son maquetas.",
  },
} as const;

const S = STRINGS[locale];
---

{/* `on-dark` — this band stays dark inside a light page, so the accent has to revert
    to full-strength orange. Without it the light-surface accent (#ba4d2d) lands on
    #0a0a0a at 3.95:1 and fails AA. */}
<section class="on-dark bg-cush-gray-900 py-20 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="max-w-2xl">
      <p
        class="font-display text-xs font-bold uppercase tracking-[0.16em] text-accent-text"
      >
        <span
          class="mr-2 inline-block h-2 w-2 animate-pulse rounded-full bg-cush-orange align-middle"
        ></span>
        {S.kicker}
      </p>
      <h2
        class="mt-4 font-display text-3xl font-bold text-white sm:text-4xl"
      >
        {S.heading}
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-gray-300">{S.sub}</p>
    </div>

    <ul class="mt-12 grid gap-6 md:grid-cols-3">
      {
        demos.map((d) => (
          <li class="relative flex flex-col overflow-hidden rounded-xl border border-gray-700 bg-black/40 transition-colors duration-300 hover:border-cush-orange focus-within:border-cush-orange">
            {/* Picture first, then name, then button — the scanning order. On phones
                the cards stack, so the picture is capped (~300px) to keep the button
                on screen; the bottom fade makes the crop look deliberate. */}
            {d.image && (
              <div class="relative">
                <img
                  src={d.image}
                  alt={d.imageAlt ?? ""}
                  width="600"
                  height="800"
                  loading="lazy"
                  decoding="async"
                  class="block aspect-[3/4] max-h-[300px] w-full object-cover object-top md:max-h-none"
                />
                <div
                  class="pointer-events-none absolute inset-x-0 bottom-0 h-10"
                  style="background: linear-gradient(to bottom, rgb(6 6 6 / 0), rgb(6 6 6));"
                  aria-hidden="true"
                ></div>
              </div>
            )}
            <div class="flex flex-1 flex-col p-6">
            {/* 2026-10-10: name + one line + one button. The section headline says
                "Stop reading", so the cards must not make people read; the longer
                copy (badge, tagline, paragraph, ice breakers) stays in liveDemos.ts
                for /messenger-assistant/. Pictures (2026-10-10) are Robert's own screenshots,
                cropped to the top 3:4 — never placeholders or invented chats. The one
                "Live" kicker sits above the headline; the cards don't repeat it. */}
            <h3 class="font-display text-2xl font-bold text-white">
              {d.name}
            </h3>
            <p class="mt-2 flex-grow text-base leading-relaxed text-gray-300">
              {d.line ?? d.tagline}
            </p>
            <a
              href={d.ownBot ? `${d.href}?ref=demos-page` : d.href}
              data-analytics-event="live_demo_opened"
              data-analytics-label={d.name}
              data-analytics-placement="demos-strip"
              target="_blank"
              rel="noopener noreferrer"
              class="mt-6 block rounded-lg bg-cush-orange px-5 py-3 text-center font-display text-sm font-semibold text-black transition-opacity duration-300 hover:opacity-90 after:absolute after:inset-0 after:content-[''] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
            >
              {d.ctaShort ?? d.cta}
            </a>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
