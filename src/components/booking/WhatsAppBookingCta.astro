---
/**
 * "Book on WhatsApp" — opens a chat with the CushLabs WhatsApp number with the
 * booking request pre-typed. Sending it gets the booking Flow (day → time →
 * details) served by cushlabs-whatsapp (docs/BOOKING-FLOW.md there), which
 * books through this repo's cushlabs-booking Worker. Added 2026-10-06.
 *
 * This is Robert's OWN consultation booking. It is not a WhatsApp product
 * claim: the capability registry has the WhatsApp approvals as robert_only,
 * and "AI on WhatsApp" stays off the offer (docs/AI-ASSISTANT-ONBOARDING.md).
 *
 * The pre-typed text and the number live in src/lib/whatsapp-booking.ts, shared
 * with the Spanish homepage hero, and must keep matching bookingIntent() in
 * cushlabs-whatsapp src/flows/booking.ts.
 */
import { whatsappBookingHref } from "../../lib/whatsapp-booking";

interface Props {
  locale: "en" | "es";
}
const { locale } = Astro.props;

const S = {
  es: {
    title: "Agenda por WhatsApp",
    body: "Elige día y hora sin salir de WhatsApp. Toma menos de un minuto y el enlace de Google Meet te llega ahí mismo.",
    button: "Agendar por WhatsApp",
    or: "¿Estás en la computadora? Elige tu horario en el calendario.",
  },
  en: {
    title: "Book on WhatsApp",
    body: "Pick a day and time without leaving WhatsApp. It takes under a minute and the Google Meet link arrives right in the chat.",
    button: "Book on WhatsApp",
    or: "On a computer? Pick your time on the calendar.",
  },
}[locale];

const href = whatsappBookingHref(locale);
---

<div class="rounded-2xl border border-border bg-surface p-5">
  <h2 class="font-display text-base font-bold text-foreground">{S.title}</h2>
  <p class="mt-2 text-sm text-muted">{S.body}</p>
  <a
    href={href}
    target="_blank"
    rel="noopener noreferrer"
    data-analytics-event="whatsapp_booking_clicked"
    data-analytics-placement="booking-page"
    class="mt-4 inline-flex w-full items-center justify-center gap-2 rounded-xl bg-[#25D366] px-5 py-2.5 font-display text-sm font-semibold text-white transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#25D366]"
  >
    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
      ><path
        d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 018.413 3.488 11.824 11.824 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"
      ></path></svg
    >
    {S.button}
  </a>
  <p class="mt-3 text-xs text-muted">{S.or}</p>
</div>
