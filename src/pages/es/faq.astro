---
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { Locale } from "../../i18n";

const locale: Locale = "es";

const content = {
  title: "Preguntas: Planes, WhatsApp y Facturación | CushLabs.ai",
  description: "Respuestas claras sobre planes y precios de CushLabs, automatización de WhatsApp, Instagram y Messenger, factura y CFDI, tiempos y de quién son tus cuentas.",
  heading: "Preguntas Frecuentes",
  subheading: "Respuestas claras sobre lo que hacemos, lo que cuesta y lo que no hacemos",
  // Cada respuesta repite algo ya publicado o canónico: PricingSection /
  // PricingComparison y operating-system/cushlabs/commercial-terms.json.
  // Se cambian primero esos y luego esta página. Reconstruida 2026-10-08,
  // en paralelo con /faq/.
  categories: [
    {
      name: "Planes y precios",
      faqs: [
        {
          question: "¿Cuánto cuesta?",
          answer: {
            mxn: "Tres planes mensuales, por negocio: Básico $1,990, Premium $3,490 y Ultra $5,490 MXN al mes, más IVA. Todos los planes incluyen hasta 2 sucursales; cada sucursal adicional son +$690 MXN al mes. Sin cuota de instalación y sin contrato. La comparación completa está en la página de Precios.",
            usd: "Tres planes mensuales, por negocio: Básico $129, Premium $229 y Ultra $349 USD al mes. Todos los planes incluyen hasta 2 sucursales; cada sucursal adicional son +$49 USD al mes. Sin cuota de instalación y sin contrato. La comparación completa está en la página de Precios.",
          }
        },
        {
          question: "¿Qué incluye cada plan?",
          answer: "Básico: un asistente de IA en tu Facebook Messenger, 24/7; respuesta a tus reseñas de Google (tú apruebas la respuesta y se publica sola); cada prospecto capturado, con alerta al instante por WhatsApp para ti; todo administrado por nosotros. Premium agrega Instagram (el mismo asistente responde comentarios y da seguimiento por mensaje directo), un chatbot para tu sitio web, recordatorios, confirmaciones y promociones por WhatsApp desde tu propio número, y un reporte semanal de SEO local y competencia. Ultra agrega un Agente de Voz con IA que contesta tu teléfono (300 minutos contestados por sucursal al mes incluidos), soporte prioritario y ajuste al vocabulario de tu giro."
        },
        {
          question: "¿Hay cuota de instalación, contrato o prueba gratis?",
          answer: "Sin cuota de instalación y sin contrato — es mes a mes. Todos los planes empiezan con una prueba gratis de 1 semana, y la semana empieza cuando tu asistente entra en línea, no cuando firmas. Cancela cuando quieras: aplica al terminar el mes que ya pagaste, y no queda nada más por saldar."
        },
        {
          question: "¿Puedo cambiar de plan después?",
          answer: "Cuando quieras, hacia arriba o hacia abajo, sin penalización. Empieza en Básico, pásate a Premium cuando quieras Instagram, la automatización de WhatsApp y el chatbot web, y agrega el agente de voz de Ultra cuando estés listo. Los cambios aplican en el siguiente ciclo de facturación."
        },
        {
          question: "¿Qué significa \"conversaciones ilimitadas (uso justo)\"?",
          answer: "No medimos ni te cobramos por mensaje — atiende a todos los clientes que quieras. El \"uso justo\" es solo una protección contra el abuso automatizado; un negocio normal nunca se acerca al límite. Si algún día tu volumen crece a escala empresarial, te buscamos y definimos juntos la configuración correcta — sin cargos sorpresa."
        },
      ]
    },
    {
      name: "Automatización de WhatsApp",
      faqs: [
        {
          question: "¿Trabajan con WhatsApp?",
          answer: "Sí — automatización de WhatsApp, de tres formas, y lo que las separa es la dirección del mensaje. (1) Alertas al dueño: nosotros TE escribimos en cuanto una conversación muestra intención real de compra — activo en todos los planes. (2) Recordatorios y confirmaciones: recordatorios de cita, confirmaciones y avisos de pedido que tu negocio envía a clientes que lo autorizaron — activo en Premium y Ultra. (3) Promociones: mensajes de marketing a tu lista con consentimiento — activo en Premium y Ultra. En corto: la 1 te avisa, la 2 les recuerda, la 3 les promociona."
        },
        {
          question: "¿Su IA puede contestarles a mis clientes por WhatsApp?",
          answer: "No, y es a propósito. Cuando tus clientes responden por WhatsApp, la respuesta te llega a ti, no a un bot — un número que molesta a la gente es un número que Meta puede restringir, y en WhatsApp tus clientes esperan a una persona. La IA contesta en Facebook Messenger, Instagram y tu sitio web; en WhatsApp automatizamos lo que tu negocio envía y te avisamos en cuanto alguien está listo para hablar."
        },
        {
          question: "En WhatsApp, ¿quién me cobra qué?",
          answer: "Son dos cobros distintos y nunca se enciman. Nosotros te cobramos la mensualidad, que cubre la configuración, la redacción de tus plantillas y su aprobación con Meta, las campañas y los reportes. Meta te cobra directo cada mensaje que tu negocio envía — en tu propia cuenta, a la tarifa que Meta publica. Los mensajes que tus clientes te envían son gratis. Somos Tech Provider de Meta, así que nos pagas por la automatización, no por tu volumen de mensajes, y nunca le agregamos nada a la tarifa de Meta."
        },
        {
          question: "¿Cuánto me cuesta mandarles una promoción a mis clientes?",
          answer: "Nada extra de nuestra parte. Redactarla, conseguir que Meta apruebe la plantilla y enviarla ya vienen en tu plan, igual que tus recordatorios de cita. El único costo es el de Meta por entregar cada mensaje, en tu propia cuenta de WhatsApp y a la tarifa que Meta publica — los mensajes promocionales cuestan más por mensaje que los recordatorios. La cuenta está a nombre de tu negocio, así que puedes ver exactamente cuánto cobró Meta."
        },
        {
          question: "¿Por qué importa cómo se clasifican mis plantillas de WhatsApp?",
          answer: "Porque Meta cobra alrededor de 3.5 veces más por una plantilla de marketing que por una de utilidad, y Meta decide cuál es cuál según el contenido del mensaje, no según la etiqueta que le pongas. Basta una línea promocional en un recordatorio de cita para que toda la plantilla se cobre como marketing. Redactar tus plantillas para que de verdad califiquen como utilidad, dejar la promoción en su propio mensaje y vigilar una reclasificación es parte de lo que hacemos. No disfrazamos marketing de utilidad — la cuenta que Meta restringiría sería la tuya."
        },
        {
          question: "¿Puedo mandarle mensajes a cualquiera, o a una lista comprada?",
          answer: "Solo listas con consentimiento. Los recordatorios van a clientes que lo autorizaron y las promociones a personas que aceptaron saber de ti. No trabajamos con listas compradas — eso protege la reputación de tu número tanto como la nuestra."
        },
        {
          question: "¿Puedo agregar un segundo número de WhatsApp?",
          answer: {
            mxn: "Sí: un número de WhatsApp adicional son +$690 MXN al mes, porque cada número carga con su propio registro, sus plantillas y su calificación de calidad.",
            usd: "Sí: un número de WhatsApp adicional son +$49 USD al mes, porque cada número carga con su propio registro, sus plantillas y su calificación de calidad.",
          }
        },
      ]
    },
    {
      name: "Facebook, Instagram, sitio web, reseñas y teléfono",
      faqs: [
        {
          question: "No tengo sitio web. ¿Esto es para mí?",
          answer: "Sí. Para muchos negocios la página de Facebook es su tienda, y ahí es justo donde trabaja el asistente: contesta Messenger 24/7, captura al prospecto y te avisa por WhatsApp cuando alguien está listo para comprar. No necesitas sitio web, Meta Business Suite ni ninguna app nueva."
        },
        {
          question: "¿Qué planes incluyen Instagram?",
          answer: "Premium y Ultra. El mismo asistente que contesta en Messenger responde en público los comentarios de tus publicaciones de Instagram y luego da seguimiento por mensaje directo."
        },
        {
          question: "¿Cómo me entero de un nuevo prospecto?",
          answer: "En cuanto un prospecto está listo — o una conversación necesita a una persona — recibes una alerta al instante por WhatsApp, además de correo y un aviso dentro de Messenger. Incluido en todos los planes."
        },
        {
          question: "¿Cómo funcionan las reseñas de Google?",
          answer: "Leemos tus reseñas directamente de Google, así que una nueva aparece en cuestión de horas, no días. Redactamos una respuesta, tú la apruebas y se publica de vuelta en Google automáticamente. Las recomendaciones de Facebook, TripAdvisor y otros sitios de reseñas no los atendemos hoy — Google es el que mueve la búsqueda local."
        },
        {
          question: "¿Qué pasa si me paso de los 300 minutos de voz en Ultra?",
          answer: {
            mxn: "Nada se detiene — el agente sigue contestando. Los minutos contestados extra se cobran a $8.50 MXN por minuto, y te avisamos conforme te acercas a los 300 incluidos para que no haya sorpresas.",
            usd: "Nada se detiene — el agente sigue contestando. Los minutos contestados extra se cobran a $0.59 USD por minuto, y te avisamos conforme te acercas a los 300 incluidos para que no haya sorpresas.",
          }
        },
        {
          question: "¿No puedo usar ChatGPT o armar un chatbot yo mismo?",
          answer: "Puedes, y entonces el que lo opera eres tú. Con nosotros está todo administrado: el asistente solo responde con información que tú aprobaste, pasa la conversación a una persona cuando no sabe, te avisa por WhatsApp cuando un prospecto está listo, y alguien con nombre lo corrige cuando hace falta. Nunca tienes que aprender ni operar el software."
        },
      ]
    },
    {
      name: "Pagos y facturación",
      faqs: [
        {
          question: "¿Cómo pago?",
          answer: {
            mxn: "Mes a mes, por adelantado, por transferencia bancaria (SPEI) o PayPal. El pago con tarjeta todavía no está disponible.",
            usd: "Mes a mes, por adelantado, por PayPal o transferencia bancaria — sin enviar dinero al extranjero. El pago con tarjeta todavía no está disponible.",
          }
        },
        {
          question: "¿Qué factura recibo y los precios incluyen impuestos?",
          answer: {
            mxn: "Los precios son más IVA, como cualquier servicio empresarial en México, y cada pago incluye tu factura (CFDI) con el IVA desglosado, así que es deducible y tu contabilidad queda en orden desde el primer día.",
            usd: "Recibes una factura comercial desglosada con cada pago — servicios, monto y condiciones de pago, lista para tu contabilidad. Los impuestos que apliquen se definen en tu contrato de servicio.",
          }
        },
        {
          question: "¿Por qué los precios son distintos en pesos y en dólares?",
          answer: "Porque son dos listas de precios distintas: MXN para México y Latinoamérica, USD para Estados Unidos y Canadá. Cada una se fija por separado, así que el precio que ves no se mueve con el tipo de cambio."
        },
      ]
    },
    {
      name: "Configuración y propiedad",
      faqs: [
        {
          question: "¿Cuánto tarda la configuración?",
          answer: "Las configuraciones simples se lanzan en días; las integraciones más complejas suelen tomar de 2 a 6 semanas. Tu semana gratis empieza hasta que tu asistente está en línea."
        },
        {
          question: "¿De quién son mi página de Facebook, mi número de WhatsApp y mi perfil de Google?",
          answer: "Tuyos, siempre. Trabajamos como colaboradores en cuentas que quedan a tu nombre — nunca tomamos la propiedad de una página, un número, un perfil ni un dominio. Tu cuenta de WhatsApp Business se abre a tu nombre y con tu propio método de pago, y si algún día te vas, el número y cada plantilla que Meta aprobó se van contigo. También te entregamos tu base de conocimiento: tu información, tu tono, tus preguntas frecuentes."
        },
        {
          question: "¿Qué cuenta como una \"sucursal\"?",
          answer: {
            mxn: "Una dirección física del negocio — un local, clínica u oficina con su propio perfil de Google. Todos los planes incluyen hasta dos; después son +$690 MXN por sucursal al mes, en cualquier nivel.",
            usd: "Una dirección física del negocio — un local, clínica u oficina con su propio perfil de Google. Todos los planes incluyen hasta dos; después son +$49 USD por sucursal al mes, en cualquier nivel.",
          }
        },
        {
          question: "Tengo dos sitios web del mismo negocio. ¿Eso cuesta extra?",
          answer: {
            mxn: "Un plan cubre una marca y una base de conocimiento. Premium incluye un sitio web y Ultra incluye dos. Una superficie adicional de la misma marca — otro sitio, otra cuenta de Instagram, otra página — son +$490 MXN al mes. Una marca realmente distinta, con información distinta, es un plan aparte, y te lo decimos desde el principio.",
            usd: "Un plan cubre una marca y una base de conocimiento. Premium incluye un sitio web y Ultra incluye dos. Una superficie adicional de la misma marca — otro sitio, otra cuenta de Instagram, otra página — son +$35 USD al mes. Una marca realmente distinta, con información distinta, es un plan aparte, y te lo decimos desde el principio.",
          }
        },
      ]
    },
    {
      name: "Calidad, privacidad y cómo trabajamos",
      faqs: [
        {
          question: "¿Y si el asistente contesta algo mal?",
          answer: "Nos avisas y lo corregimos el mismo día — con una persona con nombre y apellido que responde por ello, no un centro de soporte anónimo. No vamos a prometer cero errores; quien lo promete no ha operado uno de estos en producción. El asistente solo responde con información que tú aprobaste, y cuando no sabe algo lo dice y pasa la conversación a una persona en lugar de inventar una respuesta."
        },
        {
          question: "¿Qué pasa con las conversaciones de mis clientes?",
          answer: "Se usan para atender a tu negocio y para nada más. Nunca se venden ni entrenan nada para otro cliente."
        },
        {
          question: "¿El asistente habla español e inglés?",
          answer: "Sí. Tu asistente contesta en los dos idiomas, y se revisa en ambos antes de entrar en línea."
        },
        {
          question: "¿Con quién voy a trabajar?",
          answer: "Directamente con Robert Cushman — no con una agencia de ejecutivos de cuenta y traspasos. Robert ocupó puestos de liderazgo de TI en Praxair/Linde, una empresa Fortune 500: más de 100 iniciativas tecnológicas globales para 26,000 empleados en 42 países. Vive en Guadalajara y trabaja con negocios en México, Estados Unidos y Latinoamérica."
        },
      ]
    },
  ],
  cta: {
    heading: "¿Aún tienes preguntas?",
    text: "Agenda una llamada gratuita de 30 minutos. Sin compromiso, sin presión — solo respuestas honestas sobre si podemos ayudarte.",
    button: "Agenda una Llamada Gratis de 30 Min",
    href: "/es/reservar/"
  }
};
// Answers that depend on the market are { mxn, usd } pairs. The page opens on
// the visitor's language (English → US & Canada, Spanish → México & LatAm) and
// a currency picked here or on /pricing/ wins afterwards — same rule and same
// stored key ("pricingCurrency") as PricingSection.astro, so the two pages
// never disagree about which market the visitor is in.
type Answer = string | { mxn: string; usd: string };
const defaultCurrency: "mxn" | "usd" = "mxn";
const hideIf = (cur: "mxn" | "usd") => (cur === defaultCurrency ? "" : "hidden");
const forSchema = (a: Answer) => (typeof a === "string" ? a : a[defaultCurrency]);
const cur = { aria: "Selecciona tu región y moneda", mxn: "México & LatAm · MXN", usd: "EE.UU. & Canadá · USD" };
---

<BaseLayout title={content.title} description={content.description}>
  <!-- FAQPage structured data for rich results -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": content.categories.flatMap(cat => cat.faqs.map(faq => ({
      "@type": "Question",
      "name": faq.question,
      "acceptedAnswer": { "@type": "Answer", "text": forSchema(faq.answer) }
    })))
  })} />

  <div class="min-h-screen bg-white dark:bg-gray-950">
    <!-- Hero -->
    <section class="relative pt-24 pb-12">
      <div class="absolute inset-0 -z-10">
        <div class="absolute top-20 left-1/4 w-96 h-96 bg-cush-orange/10 rounded-full blur-3xl"></div>
      </div>

      <div class="mx-auto max-w-3xl px-4 text-center">
        <h1 class="font-display text-4xl font-bold text-gray-900 dark:text-white md:text-5xl">
          {content.heading}
        </h1>
        <p class="mt-4 text-lg text-gray-600 dark:text-gray-400">
          {content.subheading}
        </p>
        <div
          class="mt-8 inline-flex items-center gap-1 rounded-lg border border-gray-200 dark:border-gray-700 p-1 bg-white dark:bg-gray-800/40"
          role="group"
          aria-label={cur.aria}
        >
          {(["mxn", "usd"] as const).map((c) => (
            <button
              type="button"
              data-cur-btn={c}
              aria-pressed={defaultCurrency === c ? "true" : "false"}
              class={`px-4 py-2 rounded-md text-sm font-display font-semibold transition-colors ${defaultCurrency === c ? "bg-cush-orange text-black" : "text-gray-600 dark:text-gray-300"}`}
            >
              {cur[c]}
            </button>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ Content -->
    <section class="pb-16">
      <div class="mx-auto max-w-3xl px-4">
        {content.categories.map((category, catIndex) => (
          <div class="mb-12">
            <h2 class="font-display text-xl font-semibold text-accent-text mb-6">
              {category.name}
            </h2>
            <div class="space-y-4">
              {category.faqs.map((faq) => (
                <details class="group border border-gray-200 dark:border-gray-800 rounded-xl overflow-hidden">
                  <summary class="flex items-center justify-between p-6 cursor-pointer bg-white dark:bg-gray-900 hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors">
                    <h3 class="text-lg font-display font-semibold text-gray-900 dark:text-white pr-4">
                      {faq.question}
                    </h3>
                    <svg
                      class="w-5 h-5 text-gray-500 transform transition-transform group-open:rotate-180 shrink-0"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                  </summary>
                  <div class="px-6 pb-6 pt-2 bg-white dark:bg-gray-900">
                    <p class="text-gray-600 dark:text-gray-400 leading-relaxed">
                      {typeof faq.answer === "string" ? faq.answer : (
                        <>
                          <span data-cur="mxn" class={hideIf("mxn")}>{faq.answer.mxn}</span>
                          <span data-cur="usd" class={hideIf("usd")}>{faq.answer.usd}</span>
                        </>
                      )}
                    </p>
                  </div>
                </details>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- CTA Section -->
    <section class="pb-24">
      <div class="mx-auto max-w-3xl px-4">
        <div class="text-center p-8 rounded-2xl bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-800">
          <h2 class="font-display text-2xl font-bold text-gray-900 dark:text-white mb-3">
            {content.cta.heading}
          </h2>
          <p class="text-gray-600 dark:text-gray-400 mb-6">
            {content.cta.text}
          </p>
          <a
            href={content.cta.href}
            class="inline-flex items-center gap-2 px-6 py-3 bg-cush-orange text-black font-display font-semibold rounded-lg hover:bg-cush-orange/90 transition-colors"
          >
            {content.cta.button}
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  // Same behaviour and storage key as the toggle in PricingSection.astro.
  (function () {
    const KEY = "pricingCurrency";
    function apply(c: string) {
      const isUsd = c === "usd";
      document.querySelectorAll('[data-cur="mxn"]').forEach((el) => el.classList.toggle("hidden", isUsd));
      document.querySelectorAll('[data-cur="usd"]').forEach((el) => el.classList.toggle("hidden", !isUsd));
      document.querySelectorAll("[data-cur-btn]").forEach((btn) => {
        const active = btn.getAttribute("data-cur-btn") === c;
        btn.setAttribute("aria-pressed", String(active));
        btn.classList.toggle("bg-cush-orange", active);
        btn.classList.toggle("text-black", active);
        btn.classList.toggle("text-gray-600", !active);
        btn.classList.toggle("dark:text-gray-300", !active);
      });
    }
    let saved: string | null = null;
    try {
      saved = localStorage.getItem(KEY);
    } catch (e) {
      /* no-op */
    }
    if (saved === "usd" || saved === "mxn") apply(saved);
    document.querySelectorAll("[data-cur-btn]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const c = btn.getAttribute("data-cur-btn") || "mxn";
        try {
          localStorage.setItem(KEY, c);
        } catch (e) {
          /* no-op */
        }
        apply(c);
      });
    });
  })();
</script>
