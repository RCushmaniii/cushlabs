---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Container from "../../../components/layout/Container.astro";

// Static-rendered. Query params (page_name, page_names, page_count, page_id,
// page_ids, error) leídos client-side. Los envía el callback OAuth del Worker
// (cushlabs-messenger-bot src/lib/oauth.ts, redirectToConnected).
---

<BaseLayout
  title="Conectado | Asistente Messenger CushLabs"
  description="Tu página de Facebook está conectada. Las configuraciones simples se lanzan en días; las integraciones más complejas suelen tomar de 2 a 6 semanas."
  noindex={true}
>
  <section class="relative pt-24 pb-16 md:pt-32 md:pb-24 overflow-hidden min-h-[60vh]">
    <div class="absolute inset-0 -z-10">
      <div id="bg-glow" class="absolute top-1/4 left-1/4 w-[500px] h-[500px] bg-green-500/10 rounded-full blur-[120px]"></div>
    </div>

    <Container size="md">
      <div id="loading-state" class="text-center max-w-2xl mx-auto">
        <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-gray-200 dark:bg-gray-700 mb-8 animate-pulse">
        </div>
        <div class="h-10 bg-gray-200 dark:bg-gray-700 rounded animate-pulse max-w-md mx-auto mb-4"></div>
        <div class="h-6 bg-gray-200 dark:bg-gray-700 rounded animate-pulse max-w-lg mx-auto"></div>
      </div>

      <div id="success-state" class="text-center max-w-2xl mx-auto" hidden>
        <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-green-500/15 border border-green-500/30 mb-8">
          <svg class="w-10 h-10 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
          </svg>
        </div>

        <h1 class="font-display text-fluid-4xl font-bold text-gray-900 dark:text-white mb-4 leading-tight tracking-tight">
          ¡Listo, ya estás conectado!
        </h1>

        <!-- "en" y el nombre de la página van en UNA sola línea con espacio
             literal: partidos en dos líneas, el HTML compilado mostraba
             "en<strong>Página</strong>". -->
        <p id="page-sentence" class="text-fluid-lg text-gray-600 dark:text-gray-300 mb-8 leading-relaxed">
          Autorizaste a <strong class="text-gray-900 dark:text-white">CushLabs Messaging Platform</strong>, la app de Meta detrás de tu Asistente de Messenger IA, en <strong id="page-name" class="text-gray-900 dark:text-white">tu página de Facebook</strong><span id="page-sentence-end">.</span>
        </p>

        <!-- Cada página conectada, una por renglón, cuando el Worker manda la
             lista completa. Se llena client-side; nombres solo vía textContent. -->
        <ul id="page-list" class="inline-flex flex-col items-start gap-2 mb-8 text-fluid-lg font-semibold text-gray-900 dark:text-white text-left" hidden></ul>

        <div class="bg-white dark:bg-gray-800/50 border border-gray-200 dark:border-gray-700 rounded-xl p-6 mb-10 text-left">
          <h2 class="font-display font-semibold text-lg text-gray-900 dark:text-white mb-4">
            Lo que sigue
          </h2>
          <ol class="space-y-3 text-gray-700 dark:text-gray-300">
            <li class="flex gap-3">
              <span class="text-accent-text font-display font-bold">1.</span>
              <span>Te escribiremos por correo para agendar tu llamada de levantamiento de contenido.</span>
            </li>
            <li class="flex gap-3">
              <span class="text-accent-text font-display font-bold">2.</span>
              <span>Subimos tus servicios, precios, horarios y preguntas frecuentes y afinamos al asistente con tu voz.</span>
            </li>
            <li class="flex gap-3">
              <span class="text-accent-text font-display font-bold">3.</span>
              <span>Tu asistente entra en producción en tu página y comienza la prueba gratis de 1 semana. Las configuraciones simples se lanzan en días; las integraciones más complejas suelen tomar de 2 a 6 semanas.</span>
            </li>
          </ol>
        </div>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="/es/messenger-assistant/"
            class="inline-flex items-center gap-2 px-6 py-3 bg-cush-orange text-black font-display font-semibold rounded-lg hover:bg-cush-orange/90 transition-all duration-300"
          >
            Volver a la descripción
          </a>
          <a
            href="/es/contact/"
            class="font-display font-medium text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white underline underline-offset-4 decoration-gray-300 hover:decoration-cush-orange transition-all"
          >
            ¿Preguntas? Contáctanos →
          </a>
        </div>
      </div>

      <div id="error-state" class="text-center max-w-2xl mx-auto" hidden>
        <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-amber-500/15 border border-amber-500/30 mb-8">
          <svg class="w-10 h-10 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
        </div>

        <h2 id="error-heading" class="font-display text-fluid-3xl font-bold text-gray-900 dark:text-white mb-4 leading-tight tracking-tight">
          La conexión no se completó
        </h2>

        <p class="text-fluid-lg text-gray-600 dark:text-gray-300 mb-8 leading-relaxed">
          <span id="error-message">No recibimos los datos de autorización de Facebook. Esto pasa a veces si se cancela la autorización o si la sesión expira.</span>
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="/es/messenger-assistant/connect/"
            class="inline-flex items-center gap-2 px-6 py-3 bg-cush-orange text-black font-display font-semibold rounded-lg hover:bg-cush-orange/90 transition-all duration-300"
          >
            Intentar de nuevo
          </a>
          <a
            href="/es/contact/"
            class="font-display font-medium text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white underline underline-offset-4 decoration-gray-300 hover:decoration-cush-orange transition-all"
          >
            Contáctanos →
          </a>
        </div>
      </div>
    </Container>
  </section>

  <script is:inline>
    (function () {
      const params = new URLSearchParams(window.location.search);
      // page_name es un resumen en prosa del Worker que se trunca a partir de
      // tres páginas ("A, B y 4 más"). page_names trae TODAS las páginas
      // conectadas, una por línea, para listarlas completas — un cliente que
      // vio nombrada una página demo en vez de la suya es la falla que esto
      // evita (2026-08-04).
      const pageName = params.get("page_name");
      const pageId = params.get("page_id");
      const pageNames = (params.get("page_names") || "")
        .split("\n")
        .map((s) => s.trim())
        .filter(Boolean);
      const error = params.get("error");

      const loading = document.getElementById("loading-state");
      const success = document.getElementById("success-state");
      const errorEl = document.getElementById("error-state");
      const bgGlow = document.getElementById("bg-glow");

      loading.hidden = true;

      // Códigos de error estables del callback OAuth del Worker
      // (cushlabs-messenger-bot src/lib/oauth.ts). Cancelar a propósito no es
      // un error y no debe leerse como uno. Códigos desconocidos usan el
      // texto de Facebook.
      const ERROR_COPY = {
        user_cancelled: {
          heading: "No se hizo ningún cambio",
          message:
            "Cancelaste la conexión con Facebook, así que no se modificó nada en tu página. Si querías conectarla, puedes intentarlo de nuevo cuando gustes.",
          neutral: true,
        },
        session_expired: {
          heading: "Tu enlace de conexión expiró",
          message:
            "Las sesiones seguras de conexión duran unos 10 minutos. Vuelve a empezar y completa los pasos de Facebook de una sola vez.",
        },
        no_pages: {
          heading: "No encontramos una página para conectar",
          message:
            "Facebook no mostró ninguna página en la cuenta con la que iniciaste sesión — normalmente significa que esa cuenta no es administradora de la página del negocio. Inicia sesión con la cuenta administradora o revisa los roles de tu página en Meta Business Suite.",
        },
        missing_params: {
          heading: "La conexión no se completó",
          message:
            "No recibimos los datos de autorización de Facebook. Intenta de nuevo desde el inicio.",
        },
        token_exchange_failed: {
          heading: "La conexión no se completó",
          message:
            "Facebook aceptó la conexión, pero no pudimos terminar de configurarla de nuestro lado. Intenta de nuevo — si pasa dos veces, contáctanos y lo resolvemos.",
        },
        pages_fetch_failed: {
          heading: "La conexión no se completó",
          message:
            "Facebook aceptó la conexión, pero no pudimos terminar de configurarla de nuestro lado. Intenta de nuevo — si pasa dos veces, contáctanos y lo resolvemos.",
        },
        server_misconfigured: {
          heading: "Algo falló de nuestro lado",
          message:
            "Esto es cosa nuestra, no tuya. Contáctanos y lo arreglamos de inmediato.",
        },
      };

      if (!error && (pageName || pageId || pageNames.length)) {
        const nameEl = document.getElementById("page-name");
        if (pageNames.length > 1) {
          nameEl.textContent = "estas " + pageNames.length + " páginas de Facebook";
          document.getElementById("page-sentence-end").textContent = ":";
          document.getElementById("page-sentence").classList.replace("mb-8", "mb-4");
          const list = document.getElementById("page-list");
          for (const name of pageNames) {
            const li = document.createElement("li");
            li.className = "flex items-center gap-2";
            li.innerHTML = '<svg class="w-5 h-5 text-green-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>';
            const label = document.createElement("span");
            label.textContent = name; // nunca innerHTML: el valor viene de la URL
            li.appendChild(label);
            list.appendChild(li);
          }
          list.hidden = false;
        } else if (pageNames.length === 1) {
          nameEl.textContent = pageNames[0];
        } else if (pageName) {
          nameEl.textContent = pageName;
        }
        success.hidden = false;
      } else {
        const copy = error && ERROR_COPY[error];
        if (copy) {
          document.getElementById("error-heading").textContent = copy.heading;
          document.getElementById("error-message").textContent = copy.message;
        } else if (error) {
          document.getElementById("error-message").textContent =
            'Facebook respondió: "' + error + '". Esto pasa a veces si se cancela la autorización o si la sesión expira.';
        }
        if (bgGlow) {
          bgGlow.classList.remove("bg-green-500/10");
          bgGlow.classList.add(copy && copy.neutral ? "bg-gray-400/10" : "bg-amber-500/10");
        }
        errorEl.hidden = false;
      }
    })();
  </script>
</BaseLayout>
