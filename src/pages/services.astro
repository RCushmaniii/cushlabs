---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/services2/Hero.astro";
import ScenarioQualifier from "../components/services2/ScenarioQualifier.astro";
import ServiceBlock from "../components/services2/ServiceBlock.astro";
import HowIWork from "../components/services2/HowIWork.astro";
import WhoItIsFor from "../components/services2/WhoItIsFor.astro";
import PricingSection from "../components/pricing/PricingSection.astro";
import FAQ from "../components/services2/FAQ.astro";
import FinalCTA from "../components/services2/FinalCTA.astro";

const locale = (Astro.currentLocale === "es" ? "es" : "en") as "en" | "es";

const meta = {
  en: {
    title: "AI Services — Messenger, Voice, Automation | CushLabs.ai",
    description: "Facebook Messenger AI assistant, Google Maps competitive intelligence, website chatbots, and AI voice agents. Bilingual EN/ES. Free 1-week trial.",
  },
  es: {
    title: "Servicios de IA — Messenger, Voz y Automatización | CushLabs",
    description: "Asistente de IA para Facebook Messenger, inteligencia competitiva en Google Maps, chatbots web y agentes de voz. Bilingüe. Prueba gratis 1 semana.",
  },
};
---

<BaseLayout title={meta[locale].title} description={meta[locale].description}>
  
  <Hero locale={locale} />
  
  <ScenarioQualifier locale={locale} />

  {/* STRUCTURE BEFORE DETAIL — moved here 2026-09-20, and it must stay above the
      ServiceBlocks.

      This section used to sit eighth of ten, after all five service blocks. The
      effect was that a visitor met five features, each with its own price line,
      before learning that plans exist at all — so the page read as an a-la-carte
      menu and every block looked like its own SKU. Anyone arriving from an ad
      into a specific service anchor never reached the tiers at all.

      Everything CushLabs sells is bundled into Basic / Premium / Ultra. Showing
      the three plans first makes every section below read as "here is what is
      inside a plan" rather than "here is another thing to buy". Do not move it
      back down to group it with the FAQ — it is placed for the reading order,
      not for tidiness. */}
  <PricingSection locale={locale} headingTag="h2" showCurrency={false} />

  {/* Ordered as the tier ladder a buyer climbs: Basic, then Premium, then
      Ultra. Voice is LAST deliberately — it is de-prioritized for sales, and it
      previously sat above WhatsApp, which is the thing we actually want people
      to upgrade for. Its own /voice-agent/ page and anchor are unchanged, so any
      existing inbound link or ad still lands. */}
  <ServiceBlock locale={locale} id="messenger-ai" />
  <ServiceBlock locale={locale} id="support-assistants" isAlternate={true} />
  <ServiceBlock locale={locale} id="whatsapp" />
  <ServiceBlock locale={locale} id="intelligence" isAlternate={true} />
  <ServiceBlock locale={locale} id="voice-agent" />

  <HowIWork locale={locale} />
  
  <WhoItIsFor locale={locale} />

  <FAQ locale={locale} />
  
  <FinalCTA locale={locale} />

</BaseLayout>

