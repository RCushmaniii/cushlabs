---
import BaseLayout from "../layouts/BaseLayout.astro";

const content = {
  title: "FAQ: Plans, WhatsApp Automation & Billing | CushLabs.ai",
  description: "Straight answers on CushLabs plans and prices, WhatsApp automation, Instagram and Messenger, invoices and PayPal, setup time, and who owns your accounts.",
  heading: "Frequently Asked Questions",
  subheading: "Straight answers about what we do, what it costs, and what we don't do",
  // Every answer here restates something already published or canonical:
  // PricingSection / PricingComparison (features, FAQ wording) and
  // operating-system/cushlabs/commercial-terms.json (price, trial,
  // cancellation, billing, invoicing, delivery timing). Change those first,
  // then this page — never the other way round. Rebuilt 2026-10-08 after the
  // Messenger bot told a prospect WhatsApp automation "isn't live yet".
  categories: [
    {
      name: "Plans & pricing",
      faqs: [
        {
          question: "How much does it cost?",
          answer: {
            mxn: "Three monthly plans, per business: Basic $1,990, Premium $3,490 and Ultra $5,490 MXN a month, plus IVA. Every plan includes up to 2 locations; each extra location is +$690 MXN a month. No setup fee and no contract. The full side-by-side is on the Pricing page.",
            usd: "Three monthly plans, per business: Basic $129, Premium $229 and Ultra $349 USD a month. Every plan includes up to 2 locations; each extra location is +$49 USD a month. No setup fee and no contract. The full side-by-side is on the Pricing page.",
          }
        },
        {
          question: "What's in each plan?",
          answer: "Basic: an AI assistant on your Facebook Messenger, 24/7; Google reviews answered (you approve the reply, it posts itself); leads captured, with a WhatsApp alert to you in seconds; fully managed. Premium adds Instagram (the same assistant answers comments and follows up in DMs), a website chatbot, WhatsApp reminders, confirmations and promotions sent from your own number, and a weekly local SEO and competitor report. Ultra adds an AI Voice Agent that answers your phone (300 answered minutes per location a month included), priority support, and tuning to your industry's vocabulary."
        },
        {
          question: "Is there a setup fee, a contract, or a trial?",
          answer: "No setup fee and no contract — it's month to month. Every plan starts with a 1-week free trial, and the week starts when your assistant actually goes live, not when you sign. Cancel whenever you want: it takes effect at the end of the month you have already paid for, and there is nothing else to settle."
        },
        {
          question: "Can I switch plans later?",
          answer: "Anytime, up or down, with no penalty. Start on Basic, move to Premium when you want Instagram, WhatsApp automation and the website chatbot, add Ultra's voice agent when you're ready. Changes take effect the next billing cycle."
        },
        {
          question: "What does \"unlimited conversations (fair use)\" mean?",
          answer: "We don't meter or bill you per message — talk to as many customers as you want. \"Fair use\" is just a guardrail against automated abuse; a normal small business will never come close. If your volume ever grows to enterprise scale, we'll reach out and figure out the right setup together — no surprise charges."
        },
      ]
    },
    {
      name: "WhatsApp automation",
      faqs: [
        {
          question: "Do you do WhatsApp?",
          answer: "Yes — WhatsApp automation, in three ways, and the direction of the message is what separates them. (1) Owner alerts: we message YOU the moment a conversation shows real buying intent — live on every plan. (2) Reminders and confirmations: appointment reminders, confirmations and order updates your business sends to customers who opted in — live on Premium and Ultra. (3) Promotions: marketing messages to your consented list — live on Premium and Ultra. In short: #1 alerts you, #2 reminds them, #3 promotes to them."
        },
        {
          question: "Can your AI answer my customers on WhatsApp?",
          answer: "No, and that's deliberate. When your customers reply on WhatsApp, the reply comes to you, not to a bot — a number that annoys people is a number Meta can restrict, and on WhatsApp your customers expect a person. The AI does the answering on Facebook Messenger, Instagram and your website; on WhatsApp we automate what your business sends and alert you the moment someone is ready to talk."
        },
        {
          question: "On WhatsApp, who bills me for what?",
          answer: "Two separate bills, and they never overlap. We bill you for the monthly plan, which covers setup, writing your message templates and getting them approved by Meta, running campaigns, and reporting. Meta bills you directly for each message your business sends — on your own account, at Meta's published rate. Messages your customers send to you are free. We're a Meta Tech Provider, so we're paid for the automation, not for your message volume, and we never add anything on top of Meta's rate."
        },
        {
          question: "What does it cost to send a promotion to my customers?",
          answer: "Nothing extra from us. Writing it, getting Meta to approve the template and sending it are part of your plan, the same as your appointment reminders. The only cost is Meta's, for delivering each message, on your own WhatsApp account at Meta's published rate — promotional messages cost more per message than reminders do. The account is in your name, so you can see exactly what Meta charged."
        },
        {
          question: "Why does it matter how my WhatsApp templates are categorized?",
          answer: "Because Meta charges roughly 3.5× more for a marketing template than a utility one, and Meta decides which is which from the content of the message, not from the label you give it. One promotional line in an appointment reminder and the whole template is re-priced as marketing. Writing your templates so they genuinely qualify as utility, keeping promotion in its own message, and watching for a re-categorization is part of what we do. We won't dress up marketing as utility — it's your account Meta would restrict."
        },
        {
          question: "Can I message anyone, or a list I bought?",
          answer: "Consented lists only. Reminders go to customers who opted in, and promotions go to people who agreed to hear from you. We don't work with purchased lists — that protects your number's reputation as much as ours."
        },
        {
          question: "Can I add a second WhatsApp number?",
          answer: {
            mxn: "Yes: an extra WhatsApp number is +$690 MXN a month, because every number carries its own registration, templates and quality rating.",
            usd: "Yes: an extra WhatsApp number is +$49 USD a month, because every number carries its own registration, templates and quality rating.",
          }
        },
      ]
    },
    {
      name: "Facebook, Instagram, website, reviews and phone",
      faqs: [
        {
          question: "I don't have a website. Is this still for me?",
          answer: "Yes. For many businesses the Facebook page is the storefront, and that's exactly where the assistant works: it answers Messenger 24/7, captures the lead, and alerts you on WhatsApp when someone is ready to buy. You don't need a website, Meta Business Suite or any new app to use it."
        },
        {
          question: "Which plans include Instagram?",
          answer: "Premium and Ultra. The same assistant that answers on Messenger answers comments on your Instagram posts in public, then follows up in DMs."
        },
        {
          question: "How do I hear about a new lead?",
          answer: "The moment a lead is ready — or a conversation needs a person — you get a WhatsApp alert within seconds, plus email and a note inside Messenger. Included on every plan."
        },
        {
          question: "How do Google reviews work?",
          answer: "We read your reviews straight from Google, so a new one shows up within hours, not days. We draft a reply, you approve it, and it posts back to Google automatically. Facebook recommendations, TripAdvisor and other review sites we don't manage today — Google is the one that moves local search."
        },
        {
          question: "What happens if I go over the 300 voice minutes on Ultra?",
          answer: {
            mxn: "Nothing breaks — the agent keeps answering. Extra answered minutes bill at $8.50 MXN per minute, and we flag it for you as you approach the included 300 so there are no surprises.",
            usd: "Nothing breaks — the agent keeps answering. Extra answered minutes bill at $0.59 USD per minute, and we flag it for you as you approach the included 300 so there are no surprises.",
          }
        },
        {
          question: "Can't I just use ChatGPT or a chatbot builder myself?",
          answer: "You can, and then you're the one running it. With us it's fully managed: the assistant only answers from information you approved, hands the conversation to a person when it doesn't know, alerts you on WhatsApp when a lead is ready, and someone accountable fixes it when something needs fixing. You never have to learn or run the software."
        },
      ]
    },
    {
      name: "Billing & invoices",
      faqs: [
        {
          question: "How do I pay?",
          answer: {
            mxn: "Monthly, in advance, by bank transfer (SPEI) or PayPal. Card payments aren't available yet.",
            usd: "Monthly, in advance, by PayPal or bank transfer — no need to wire money abroad. Card payments aren't available yet.",
          }
        },
        {
          question: "What invoice do I get, and is tax included?",
          answer: {
            mxn: "Prices are plus IVA, like any business service in Mexico, and every payment comes with a CFDI with the IVA itemized, so it's deductible and your accounting stays clean from day one.",
            usd: "You get an itemized commercial invoice with every payment — services, amount and payment terms, ready for your bookkeeping. Any applicable taxes are set out in your service agreement.",
          }
        },
        {
          question: "Why are the prices different in pesos and dollars?",
          answer: "Because they're two separate price lists: MXN for Mexico and Latin America, USD for the US and Canada. Each is set on its own, so the price you see doesn't move with the exchange rate."
        },
      ]
    },
    {
      name: "Setup & ownership",
      faqs: [
        {
          question: "How long does setup take?",
          answer: "Simple setups launch in days; more complex integrations typically take 2 to 6 weeks. Your free week only starts once your assistant is live."
        },
        {
          question: "Who owns my Facebook Page, WhatsApp number and Google profile?",
          answer: "You do, always. We work as a collaborator on accounts that stay in your name — we never take ownership of a page, a number, a profile or a domain. Your WhatsApp Business account is opened in your name with your own payment method, and if you ever leave, the number and every template Meta approved go with you. We also hand you your knowledge base: your information, your tone, your FAQs."
        },
        {
          question: "What counts as a \"location\"?",
          answer: {
            mxn: "One physical business address — a storefront, clinic or office with its own Google Business Profile. Every plan includes up to two; beyond that it's +$690 MXN per location a month, at any tier.",
            usd: "One physical business address — a storefront, clinic or office with its own Google Business Profile. Every plan includes up to two; beyond that it's +$49 USD per location a month, at any tier.",
          }
        },
        {
          question: "I have two websites for the same business. Does that cost extra?",
          answer: {
            mxn: "One plan covers one brand and one knowledge base. Premium includes one website and Ultra includes two. An extra same-brand surface beyond that — another site, another Instagram account, another Page — is +$490 MXN a month. A genuinely different brand with different information is a separate plan, and we'll tell you that up front.",
            usd: "One plan covers one brand and one knowledge base. Premium includes one website and Ultra includes two. An extra same-brand surface beyond that — another site, another Instagram account, another Page — is +$35 USD a month. A genuinely different brand with different information is a separate plan, and we'll tell you that up front.",
          }
        },
      ]
    },
    {
      name: "Quality, privacy & working together",
      faqs: [
        {
          question: "What if the assistant gets something wrong?",
          answer: "Tell us and we fix it the same day — with a named person accountable, not an anonymous support queue. We won't promise zero errors; anyone promising that hasn't run one of these in production. The assistant only answers from information you approved, and when it doesn't know something it says so and hands the conversation to a person rather than inventing an answer."
        },
        {
          question: "What happens to my customers' conversations?",
          answer: "They're used to serve your business and nothing else. Never sold, never used to train anything for another client."
        },
        {
          question: "Does the assistant speak Spanish and English?",
          answer: "Yes. Your assistant answers in both, and it's checked in both languages before it goes live."
        },
        {
          question: "Who will I be working with?",
          answer: "Robert Cushman, directly — not an agency with account managers and handoffs. Robert held IT leadership roles at Praxair/Linde, a Fortune 500 company: 100+ global technology initiatives supporting 26,000 employees across 42 countries. He's based in Guadalajara and works with businesses in Mexico, the US and Latin America."
        },
      ]
    },
  ],
  cta: {
    heading: "Still have questions?",
    text: "Book a free 30-minute call. No commitment, no pressure — just honest answers about whether we can help.",
    button: "Book a Free 30-Min Call",
    href: "/consultation/"
  }
};
// Answers that depend on the market are { mxn, usd } pairs. The page opens on
// the visitor's language (English → US & Canada, Spanish → México & LatAm) and
// a currency picked here or on /pricing/ wins afterwards — same rule and same
// stored key ("pricingCurrency") as PricingSection.astro, so the two pages
// never disagree about which market the visitor is in.
type Answer = string | { mxn: string; usd: string };
const defaultCurrency: "mxn" | "usd" = "usd";
const hideIf = (cur: "mxn" | "usd") => (cur === defaultCurrency ? "" : "hidden");
const forSchema = (a: Answer) => (typeof a === "string" ? a : a[defaultCurrency]);
const cur = { aria: "Select your region and currency", mxn: "México & LatAm · MXN", usd: "US & Canada · USD" };
---

<BaseLayout title={content.title} description={content.description}>
  <!-- FAQPage structured data for rich results -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": content.categories.flatMap(cat => cat.faqs.map(faq => ({
      "@type": "Question",
      "name": faq.question,
      "acceptedAnswer": { "@type": "Answer", "text": forSchema(faq.answer) }
    })))
  })} />

  <div class="min-h-screen bg-white dark:bg-gray-950">
    <!-- Hero -->
    <section class="relative pt-24 pb-12">
      <div class="absolute inset-0 -z-10">
        <div class="absolute top-20 left-1/4 w-96 h-96 bg-cush-orange/10 rounded-full blur-3xl"></div>
      </div>

      <div class="mx-auto max-w-3xl px-4 text-center">
        <h1 class="font-display text-4xl font-bold text-gray-900 dark:text-white md:text-5xl">
          {content.heading}
        </h1>
        <p class="mt-4 text-lg text-gray-600 dark:text-gray-400">
          {content.subheading}
        </p>
        <div
          class="mt-8 inline-flex items-center gap-1 rounded-lg border border-gray-200 dark:border-gray-700 p-1 bg-white dark:bg-gray-800/40"
          role="group"
          aria-label={cur.aria}
        >
          {(["mxn", "usd"] as const).map((c) => (
            <button
              type="button"
              data-cur-btn={c}
              aria-pressed={defaultCurrency === c ? "true" : "false"}
              class={`px-4 py-2 rounded-md text-sm font-display font-semibold transition-colors ${defaultCurrency === c ? "bg-cush-orange text-black" : "text-gray-600 dark:text-gray-300"}`}
            >
              {cur[c]}
            </button>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ Content -->
    <section class="pb-16">
      <div class="mx-auto max-w-3xl px-4">
        {content.categories.map((category) => (
          <div class="mb-12">
            <h2 class="font-display text-xl font-semibold text-accent-text mb-6">
              {category.name}
            </h2>
            <div class="space-y-4">
              {category.faqs.map((faq) => (
                <details class="group border border-gray-200 dark:border-gray-800 rounded-xl overflow-hidden">
                  <summary class="flex items-center justify-between p-6 cursor-pointer bg-white dark:bg-gray-900 hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors">
                    <h3 class="text-lg font-display font-semibold text-gray-900 dark:text-white pr-4">
                      {faq.question}
                    </h3>
                    <svg
                      class="w-5 h-5 text-gray-500 transform transition-transform group-open:rotate-180 shrink-0"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                  </summary>
                  <div class="px-6 pb-6 pt-2 bg-white dark:bg-gray-900">
                    <p class="text-gray-600 dark:text-gray-400 leading-relaxed">
                      {typeof faq.answer === "string" ? faq.answer : (
                        <>
                          <span data-cur="mxn" class={hideIf("mxn")}>{faq.answer.mxn}</span>
                          <span data-cur="usd" class={hideIf("usd")}>{faq.answer.usd}</span>
                        </>
                      )}
                    </p>
                  </div>
                </details>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- CTA Section -->
    <section class="pb-24">
      <div class="mx-auto max-w-3xl px-4">
        <div class="text-center p-8 rounded-2xl bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-800">
          <h2 class="font-display text-2xl font-bold text-gray-900 dark:text-white mb-3">
            {content.cta.heading}
          </h2>
          <p class="text-gray-600 dark:text-gray-400 mb-6">
            {content.cta.text}
          </p>
          <a
            href={content.cta.href}
            class="inline-flex items-center gap-2 px-6 py-3 bg-cush-orange text-black font-display font-semibold rounded-lg hover:bg-cush-orange/90 transition-colors"
          >
            {content.cta.button}
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  // Same behaviour and storage key as the toggle in PricingSection.astro.
  (function () {
    const KEY = "pricingCurrency";
    function apply(c: string) {
      const isUsd = c === "usd";
      document.querySelectorAll('[data-cur="mxn"]').forEach((el) => el.classList.toggle("hidden", isUsd));
      document.querySelectorAll('[data-cur="usd"]').forEach((el) => el.classList.toggle("hidden", !isUsd));
      document.querySelectorAll("[data-cur-btn]").forEach((btn) => {
        const active = btn.getAttribute("data-cur-btn") === c;
        btn.setAttribute("aria-pressed", String(active));
        btn.classList.toggle("bg-cush-orange", active);
        btn.classList.toggle("text-black", active);
        btn.classList.toggle("text-gray-600", !active);
        btn.classList.toggle("dark:text-gray-300", !active);
      });
    }
    let saved: string | null = null;
    try {
      saved = localStorage.getItem(KEY);
    } catch (e) {
      /* no-op */
    }
    if (saved === "usd" || saved === "mxn") apply(saved);
    document.querySelectorAll("[data-cur-btn]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const c = btn.getAttribute("data-cur-btn") || "mxn";
        try {
          localStorage.setItem(KEY, c);
        } catch (e) {
          /* no-op */
        }
        apply(c);
      });
    });
  })();
</script>
