---
import BaseLayout from "../layouts/BaseLayout.astro";
import BookingFormSteps from "../components/booking/BookingFormSteps.astro";
import WhatsAppBookingCta from "../components/booking/WhatsAppBookingCta.astro";
import { t } from "../i18n";

const locale = (Astro.currentLocale === "es" ? "es" : "en") as "en" | "es";
const dict = t(locale);
---

{/*
  Calendar first (2026-10-02). The page used to open on a hero, a "Book now"
  button, three info boxes and a session banner before any calendar. Now: who
  and what on the left, the calendar on the right; on phones the short intro,
  then the calendar, then the details. Mirror every change in es/reservar.astro.
*/}
<BaseLayout
  title={`${dict.consultation.title} | CushLabs.ai`}
  description={dict.consultation.description}
>
  <section class="mx-auto max-w-6xl px-4 pt-10 pb-24 md:pt-14">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-[minmax(0,320px)_minmax(0,1fr)] lg:gap-12">
      <div class="lg:col-start-1 lg:row-start-1">
        <div class="flex items-center gap-3">
          <img
            src="/images/about/robert-about.webp"
            alt="Robert Cushman"
            width="56"
            height="56"
            class="h-14 w-14 rounded-full object-cover border border-border"
          />
          <div>
            <p class="font-display font-semibold text-foreground">Robert Cushman</p>
            <p class="text-sm text-muted">CushLabs.ai</p>
          </div>
        </div>
        <h1 class="mt-6 font-display text-3xl font-bold tracking-tight text-foreground md:text-4xl">
          {dict.consultation.headline}
        </h1>
        <p class="mt-3 text-muted">{dict.consultation.subheadline}</p>
        <ul class="mt-5 space-y-2 text-sm font-display font-semibold text-foreground">
          <li class="flex items-center gap-2">
            <svg class="h-5 w-5 text-accent-text" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            {dict.consultation.detail1Value}
          </li>
          <li class="flex items-center gap-2">
            <svg class="h-5 w-5 text-accent-text" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
            {dict.consultation.detail2Value}
          </li>
        </ul>
      </div>

      <div id="schedule" class="lg:col-start-2 lg:row-start-1 lg:row-span-2">
        <BookingFormSteps locale={locale} />
      </div>

      <div class="space-y-4 lg:col-start-1 lg:row-start-2">
        <WhatsAppBookingCta locale="en" />
        <div class="rounded-2xl border border-border bg-surface p-5">
          <h2 class="font-display text-base font-bold text-foreground">
            {dict.consultation.whatWeCoverTitle}
          </h2>
          <p class="mt-2 text-sm text-muted">{dict.consultation.whatWeCoverBody}</p>
        </div>
        <div class="rounded-2xl border border-border bg-surface p-5">
          <h2 class="font-display text-base font-bold text-foreground">
            {dict.consultation.afterCallTitle}
          </h2>
          <p class="mt-2 text-sm text-muted">{dict.consultation.afterCallBody}</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
