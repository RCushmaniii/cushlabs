{
  "name": "cushlabs-site",
  "version": "1.0.0",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run sync:terms && npm run generate-projects && node scripts/validate-blog-translations.mjs && node scripts/generate-og-images.mjs && astro build && node scripts/seo/meta-description-gate.mjs && node scripts/validate-terms.mjs",
    "start": "astro preview",
    "lint": "eslint .",
    "typecheck": "astro sync && tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck",
    "astro:check": "astro check",
    "preview": "astro preview",
    "astro": "astro",
    "validate:portfolio-md": "tsx scripts/validate-portfolio-md.ts",
    "sync:portfolio": "tsx scripts/sync-portfolio.ts",
    "generate-projects": "tsx scripts/validate-portfolio-md.ts && tsx scripts/generate-projects.ts",
    "og:blog": "node scripts/generate-og-images.mjs",
    "sync:all": "tsx scripts/sync-all.ts",
    "audit:predeploy": "tsx scripts/audit-predeploy.ts",
    "audit:contrast": "node scripts/audit-contrast.mjs",
    "audit:contrast:dark": "node scripts/audit-contrast.mjs --dark",
    "audit:portfolio": "tsx scripts/audit-portfolio.ts",
    "generate:skills": "tsx scripts/generate-skills.ts",
    "seo:indexnow": "node scripts/seo/indexnow-submit.mjs",
    "seo:gsc": "node scripts/seo/gsc-submit-urls.mjs --sitemap",
    "seo:gsc:url": "node scripts/seo/gsc-submit-urls.mjs --url",
    "seo:submit": "npm run seo:indexnow && npm run seo:gsc",
    "audit:docs": "node scripts/audit-docs.mjs",
    "sync:terms": "node scripts/sync-terms.mjs",
    "validate:terms": "node scripts/validate-terms.mjs",
    "sync:status": "node ../operating-system/scripts/sync-check.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@sentry/astro": "^10.70.0",
    "@sentry/node": "^10.67.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@vercel/analytics": "^2.0.1",
    "astro": "^7.2.4",
    "googleapis": "^171.4.0",
    "tailwindcss": "^4.3.3"
  },
  "overrides": {
    "yaml": ">=2.8.3",
    "fast-xml-parser": ">=5.7.0",
    "vite": "^8.1.5",
    "qs": "^6.15.2",
    "@opentelemetry/core": "^2.8.0",
    "js-yaml": "^4.3.1",
    "gray-matter": {
      "js-yaml": "^3.15.1"
    },
    "nanoid": "^3.3.17"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1116.0",
    "@octokit/rest": "^22.0.1",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.50.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "gray-matter": "^4.0.3",
    "mime-types": "^3.0.2",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
