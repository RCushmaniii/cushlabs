GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_OWNER=RCushmaniii
GITHUB_REPO=cushlabs
GITHUB_API_URL=https://api.github.com

# Public (safe to expose in client)
PUBLIC_WHATSAPP_NUMBER=+523315590572
PUBLIC_CONSULTATION_URL=
PUBLIC_CONSULTATION_URL_30=
PUBLIC_CONSULTATION_URL_60=

# Cloudflare Worker that backs the consultation booking flow (/consultation/).
# REQUIRED for booking to function. When unset, src/config/api.ts yields an empty base
# URL and every date renders as unavailable -- the primary conversion page fails
# silently, with no build error. See technical debt #19.
PUBLIC_BOOKING_API_URL=

# Sentry
SENTRY_DSN=
PUBLIC_SENTRY_DSN=              # Same as SENTRY_DSN — exposed to client for error reporting
SENTRY_ORG=cushlabsai
SENTRY_PROJECT=cushlabs
SENTRY_AUTH_TOKEN=

# Gated client demos (api/demo.ts)
# One capability secret per client: DEMO_TOKEN_<COMPANY>, uppercase, matching
# the key in the DEMOS registry. NEVER put these in source — this repo is
# PUBLIC, so a committed token is a published secret that opens the client's
# proposal (pricing included) to anyone reading GitHub.
# An unset token disables that demo entirely (fails closed).
# Mint one with:
#   node -e "console.log(require('crypto').randomBytes(15).toString('base64').replace(/[^a-zA-Z0-9]/g,'').slice(0,20))"
# Set the real values in Vercel (Production/Preview/Development) and in a
# gitignored .env.local for local dev.
DEMO_TOKEN_LATIENDITA=replace_me_with_the_latiendita_secret
DEMO_TOKEN_AZUCAR=replace_me_with_the_azucar_secret
DEMO_TOKEN_LUMIERE=replace_me_with_the_lumiere_secret

# Google Search Console API — for sitemap/URL submission via npm run seo:gsc
# Base64-encoded service-account JSON. Generate via:
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes("path\to\sa-key.json"))
# Service account must be added as Owner on the GSC property (sc-domain:cushlabs.ai).
GOOGLE_SA_KEY_BASE64=
